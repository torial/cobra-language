use System.Text.RegularExpressions


class ZigCompilationMessage inherits SourceException
	"""
	Parses a single line of output from the Zig compiler.

	Zig error format:
	    path/to/file.zig:line:col: error: message text
	    path/to/file.zig:line:col: note: message text
	    path/to/file.zig:line:col: warning: message text
	    error: message text   (no source location, e.g. linker errors)

	Cobra generates intermediate .zig files named like "foo.cobra.zig".
	The fileName property strips the .zig suffix so errors map back to
	the Cobra source name used by cobraLineNumForCurly().
	"""

	test
		line = 'foo.cobra.zig:14:5: error: expected expression, found ;'
		msg = ZigCompilationMessage(line, TestCompiler())
		assert msg.isError
		assert msg.hasSourceSite
		assert msg.fileName == 'foo.cobra.zig'
		assert msg.lineNum == 14

		line = 'foo.cobra.zig:22:1: note: previous definition here'
		msg = ZigCompilationMessage(line, TestCompiler())
		assert not msg.isError
		assert msg.hasSourceSite
		assert msg.fileName == 'foo.cobra.zig'
		assert msg.lineNum == 22

		line = 'error: LLD Link... failed'
		msg = ZigCompilationMessage(line, TestCompiler())
		assert msg.isError
		assert not msg.hasSourceSite

		line = 'foo.cobra.zig:5:3: warning: unused variable'
		msg = ZigCompilationMessage(line, TestCompiler())
		assert not msg.isError
		assert msg.hasSourceSite
		assert msg.lineNum == 5

	# Zig output format: path:line:col: severity: message
	var _zigLineRegex = Regex(r'^(?<file>.+):(?<line>\d+):(?<col>\d+):\s*(?<sev>error|warning|note):\s*(?<msg>.*)$', RegexOptions(Compiled, CultureInvariant))
	var _zigErrorRegex = Regex(r'^error:\s*(?<msg>.*)$', RegexOptions(Compiled, CultureInvariant))

	def willSkipMessage(msg as String) as bool is shared
		if not msg.length, return true
		# Zig sometimes emits blank reference lines; skip them
		if msg.startsWith('referenced by:'), return true
		return false

	var _fileName as String?
	var _lineNum as int?
	var _isError as bool

	cue init(line as String, compiler as Compiler)
		require not .willSkipMessage(line)
		base.init(line)
		line = line.trim

		m = _zigLineRegex.match(line)
		if m.success
			_fileName = m.groups['file'].value
			_lineNum = int.parse(m.groups['line'].value)
			sev = m.groups['sev'].value
			_isError = (sev == 'error')
			_message = m.groups['msg'].value
		else
			m2 = _zigErrorRegex.match(line)
			if m2.success
				_isError = true
				_message = m2.groups['msg'].value
			else
				# unrecognized format — treat as non-fatal info
				_isError = false
				_message = line

	get isError as bool is override
		return _isError

	get hasSourceSite as bool is override
		return _fileName is not nil

	get fileName as String is override
		return _fileName to !

	get lineNum as int is override
		return _lineNum to !
