class UnspecifiedType
	is partial
	
	get ZigInit as String is override
		# TODO: throw Exception('Not expecting code gen for unspecified types.')
		return '!UnspecifiedType!'


##
## Enums
##

class EnumDecl is partial

	get ZigInit as String is override
		return .ZigRef + '.' + _declsInOrder[0].name

	def writeZigDef(sw as CurlyWriter) is override
		base.writeZigDef(sw)
		if 'extern' in _isNames
			return
		for attr in .attributes
			attr.writeZigDef(sw)
		.writeZigIsNames(sw)
		sw.write('enum [_name]')
		storageType = _storageType
		if storageType and storageType is not .compiler.intType
			# Cannot say UInt64 because:
			# C# error: Type byte, sbyte, short, ushort, int, uint, long, or ulong expected
			st = storageType to IntType
			branch st.size
				on  8, t = 'byte'
				on 16, t = 'short'
				on 32, t = 'int'
				on 64, t = 'long'
				else, throw FallThroughException(st)
			if not st.isSigned, t = 'u' + t
			sw.write(' : [t]')
		sw.write(' {\n')
		sw.indent
		sep, i = '', 0
		for em as EnumMember in .declsInOrder
			sw.write(sep)
			sw.write(em.name)
			if em.value, sw.write(' = [em.value]')
			i += 1
			sep = ',\n'
		sw.write('\n')
		sw.dedent
		sw.write('}\n\n')


class EnumMember is partial

	def writeZigTestInvocation(sw as CurlyWriter)
		pass

	get ZigRef as String is override
		return _enumDecl.ZigRef + '.' + .ZigName


##
## Boxes
##


class Box is partial

	get ZigNameComponent as String is override
		name = .ZigName
		i = name.indexOf('/*')  # example: /*dynamic*/object
		if i <> -1
			j = name.indexOf('*/', i)
			name = name[:i] + name[j+2:]
		# qualified types and generics need cleanup
		for ch in '.<>, '
			name = name.replace(ch, c'_')
		return name

	get ZigThis as String
		"""
		Returns 'this' as you would expect.
		Overridden by Extension.
		"""
		return 'this'

	get ZigKeyWord as String is abstract

	get ZigName as String is override
		return _name.replace('<of', '<')

	def _computeZigRef as String is override
		if _genericParams.count
			sb = StringBuilder()
			# generic
			name = .rootName
			sb.append(name)
			sb.append('<')
			sep = ''
			for param in _genericParams
				sb.append(sep)
				sb.append(param.ZigRef)
				sep = ', '
			sb.append('>')
			Zig = sb.toString
		else
			Zig = .ZigName
		if .parentNameSpace
			if .parentNameSpace.isRoot
				Zig = 'global::' + Zig
			else
				Zig = .parentNameSpace.ZigQualifier + Zig
		else if .parentBox
			Zig = .parentBox.ZigRef + '.' + Zig
		return Zig

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		if .isExtern, return
		.compiler.boxStack.push(this)
		try
			assert not .isConstructed
			.writeZigAttribs(sw)
			.writeZigIsNames(sw)
			sw.write('[.ZigKeyWord] ')
			.writeZigDefName(sw)
			.writeZigInheritance(sw)
	
			sep = ''
			for inter in _baseInterfaces
				sw.write(sep)
				sw.write(inter.ZigRef)
				sep = ', '
	
			if _genericParams.count
				sw.indent
				for param in _genericParams
					if param inherits GenericParam
						param.writeZigConstraint(sw)
				sw.dedent
	
			sw.writeAndIndent('{\n')
			.writeZigInvariantMethod(sw)
			if not .isGenericDef
				for tm in _testMethods
					.compiler.boxMemberStack.push(tm)
					try,     tm.writeZigDef(sw)
					finally, .compiler.boxMemberStack.pop
			for decl in _declsInOrder
				if not .willWriteDeclZigDef(decl), continue
				.compiler.boxMemberStack.push(decl)
				try
					decl.writeZigDef(sw)
				finally
					.compiler.boxMemberStack.pop
			if .compiler.includeTests and not .isGenericDef, .writeZigTest(sw)
			sw.dedentAndWrite('} // [.ZigKeyWord] [.name]\n')
			sw.write('\n')
		finally
			.compiler.boxStack.pop
		if .compiler.includeTests and .isGenericDef, .writeZigTestsForGeneric(sw)

	def writeZigTestsForGeneric(sw as CurlyWriter)
		sw.write('public class [.ZigNameComponent]_Tests_[.serialNum] {\n')
		sw.write('// tests for: [.name]\n')

		for tm in _testMethods
			.compiler.boxMemberStack.push(tm)
			try,     tm.writeZigDef(sw)
			finally, .compiler.boxMemberStack.pop
		.writeZigTest(sw)

		for decl in _declsInOrder
			if not .willWriteDeclZigDef(decl), continue
			.compiler.boxMemberStack.push(decl)
			try
				# decl.writeZigDef(sw)
				(decl to BoxMember).writeZigTest(sw)
			finally
				.compiler.boxMemberStack.pop

		sw.write('}\n\n')

	def willWriteDeclZigDef(decl) as bool
		return true

	def writeZigAttribs(sw as CurlyWriter)
		for attrib in _attribs
			attrib.writeZigDef(sw)

	def writeZigDefName(sw as CurlyWriter)
		sw.write('[.rootName]')
		if _genericParams.count
			sw.write('<')
			sep = ''
			for param in _genericParams
				sw.write(sep)
				param.writeZigDef(sw)
				sep = ', '
			sw.write('>')

	def writeZigInheritance(sw as CurlyWriter)
		"""
		Class uses this to write its base class declaration.
		No box uses this to write interface implementation--that's handled in the Box class.
		"""
		pass

	get ZigInvariantVisibility as String is abstract

	def writeZigInvariantMethod(sw as CurlyWriter)
		if .compiler.options['contracts'] <> 'none'
			sw.write('\nint _ih_invariantGuard;\n\n')
		if .compiler.options['contracts'] <> 'methods'
			return
		sw.write('\n[.ZigInvariantVisibility] void invariant_[.rootName]() {\n')
		sw.indent
		if _baseClass and (not _baseClass.isFromBinaryLibrary or _baseClass.declForName('invariant_[_baseClass.rootName]'))
			sw.write('invariant_[_baseClass.rootName]();\n')
		.writeZigInvariantChecks(sw)
		sw.dedent
		sw.write('}\n\n')

	def writeAllZigInvariantChecks(sw as CurlyWriter)
		"""
		Writes all C# invariant checks including inherited. In support of -contracts:inline
		"""
		_writeAllZigInvariantChecks(sw, this)

	def _writeAllZigInvariantChecks(sw as CurlyWriter, box as Box)
		if box.baseClass and not box.baseClass.isFromBinaryLibrary
			_writeAllZigInvariantChecks(sw, box.baseClass to !)
		box.writeZigInvariantChecks(sw)
		
	def writeZigInvariantChecks(sw as CurlyWriter)
		"""
		Writes the C# invariant checks just for this class.
		"""
		for expr in _invariants
			ZigThis = 'typeof([.ZigRef])'
			sw.write('if (!')
			expr.writeZigDef(sw)
			sw.write(')\n')
			sw.indent
			sw.write('throw new CobraCoreInternal.InvariantException([expr.ZigSourceSite(.name, "invariant", ZigThis)], ')
			expr.writeZigBreakdown(sw)
			sw.write('[ZigThis], null);\n')
			sw.dedent

	def writeZigTest(sw as CurlyWriter)
		pass

	def writeZigTestInvocation(sw as CurlyWriter) is override
		pass

	get newForZigTest as String
		return ''


class ClassOrStruct is partial

	get ZigRef as String
		if .isGeneric and .isGenericDef
			return .qualifiedRootName + '<' + String(c',',.genericParams.count-1) + '>'
		else
			return base.ZigRef


class Class is partial

	get ZigInit as String is override
		return 'null'

	get ZigInvariantVisibility as String is override
		return 'protected'

	get ZigKeyWord as String is override
		return 'class'

	def writeZigInheritance(sw as CurlyWriter) is override
		sw.write(' : ')
		if _baseClass
			sw.write(_baseClass.ZigRef)
			didWrite = true
		if didWrite
			if _baseInterfaces.count
				sw.write(', ')
			else
				sw.write(' ')

	get newForZigTest as String is override
		return if(not _baseClass.isExtern, ' new', '')


class Interface is partial

	get ZigInit as String is override
		return 'null'

	get ZigInvariantVisibility as String is override
		throw ShouldNotCallException(.getType)

	get ZigKeyWord as String is override
		return 'interface'

	def writeZigInheritance(sw as CurlyWriter) is override
		if _baseInterfaces.count
			sw.write(' : ')

	def writeZigInvariantMethod(sw as CurlyWriter) is override
		# Even when invariants are inherited by the classes and structs that implement them,
		# the code gen for the interface invariant does not go "here", inside the C# interface definition.
		pass

	def writeZigTest(sw as CurlyWriter) is override
		# Static methods can't be put in interfaces. However, at some point Cobra should support
		# tests for interfaces which could then be run against the classes that implement them.
		# Just requires more code gen smarts.
		pass

	def writeZigTestInvocation(sw as CurlyWriter) is override
		pass


class Mixin is partial

	get ZigName as String
		name = base.ZigName
		# to-do: if .canHaveStatements, name += 'Mixin'
		return name
		
	get ZigKeyWord as String is override
		return if(.canHaveStatements, 'class', 'interface')

	shared
		var _nonPublicVisibility = ['protected', 'internal', 'protected internal', 'private']

	def willWriteDeclZigDef(decl) as bool is override
		# this is for writing the interface
		if decl inherits BoxVar, return false
		for viz in _nonPublicVisibility
			for name in decl.isNames
				if name == viz, return false
		return true 

	def writeZigDef(sw as CurlyWriter)
		# write the interface
		_canHaveStatements = false
		base.writeZigDef(sw)
/#
		# write the class
		_ZigRef = nil
		_canHaveStatements = true
		base.writeZigDef(sw)
#/


class Struct is partial

	get ZigInit as String is override
		# all structs have a valid parameterless constructor
		return 'new [.ZigRef]()'

	get ZigInvariantVisibility as String is override
		return 'private'

	get ZigKeyWord as String is override
		return 'struct'

	def writeZigInheritance(sw as CurlyWriter) is override
		if _baseInterfaces.count, sw.write(' : ')

	def willWriteDeclZigDef(decl) as bool is override
		return not (decl inherits Initializer) or (decl to Initializer).hasParams


class MethodSig is partial

	def writeZigDef(sw as CurlyWriter) is override
		if .isExtern, return
		.writeZigAttribs(sw)
		.writeZigIsNames(sw)
		sw.write('delegate [.resultType.ZigRef] [.rootName]')
		if _genericParams.count
			sw.write('<')
			sep = ''
			for genericParam in _genericParams
				sw.write(sep)
				genericParam.writeZigDef(sw)
				sep = ', '
			sw.write('>')
		sw.write('(')
		sep = ''
		for param in .params
			sw.write(sep)
			param.writeZigDef(sw)
			sep = ', '
		sw.write(');\n')

	def writeZigTest(sw as CurlyWriter) is override
		pass

	def writeZigTestInvocation(sw as CurlyWriter) is override
		pass


class GenericParam
	is partial

	get ZigInit as String is override
		return 'default([_name])'

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		sw.write(.name)

	def writeZigConstraint(sw as CurlyWriter)
		if _constraints.count
			sw.write(' where [_name] :  ')
			sep = ''
			for constraint in _constraints
				sw.write(sep)
				constraint.writeZigDef(sw)
				sep = ', '
			sw.write('\n')


class GenericClassConstraint
	is partial

	def writeZigDef(sw as CurlyWriter) is override
		sw.write('class')


class GenericStructConstraint
	is partial

	def writeZigDef(sw as CurlyWriter) is override
		sw.write('struct')


class GenericCallableConstraint
	is partial

	def writeZigDef(sw as CurlyWriter) is override
		sw.write('new()')


class GenericTypeConstraint
	is partial

	def writeZigDef(sw as CurlyWriter) is override
		sw.write(_representedType.ZigRef)


class Extension
	is partial

	def _computeZigRef as String is override
		Zig = .ZigName
		if .parentNameSpace and not .parentNameSpace.isRoot
			Zig = .parentNameSpace.ZigQualifier + Zig
		else if .parentBox
			Zig = .parentBox.ZigRef + '.' + Zig
		return Zig

	get ZigInit as String is override
		return _extendedBox.ZigInit

	get ZigInvariantVisibility as String is override
		return _extendedBox.ZigInvariantVisibility

	get ZigKeyWord as String is override
		return 'class'  # because the extension is always housed in a C# class

	var _backEndName as String?

	get ZigName as String is override
		if not _backEndName
			_backEndName = if(.nativeType, .nativeType.name, 'Extend_[.extendedBox.ZigNameComponent]_[Utils.toIdentifier(Path.getFileNameWithoutExtension(.compiler.curModule.fileName) to !)]')
		return _backEndName to !

	get ZigThis as String is override
		return '_lh_this'

	def extendedMethodGenericParams(genericParams as IList<of IType>) as IList<of IType> is override
		if .isGeneric
			# the generated static C# method will need the generic params of the extension on it
			# since C# itself doesn't have "extension types", only extension methods
			r = List<of IType>(.genericParams)
			r.addRange(genericParams)
			return r
		else
			return base.extendedMethodGenericParams(genericParams)

	def writeZigDefName(sw as CurlyWriter) is override
		# replace base behavior
		sw.write(.ZigName)

	def writeZigDef(sw as CurlyWriter) is override
		for decl in .declsInOrder
			if decl inherits BoxMember
				decl.ZigExtraIsNames = {'static'}
				if decl inherits AbstractMethod
					decl.params.insert(0, Param('_lh_this', .extendedBox, isImplicit=true).bindAll to Param)
		base.writeZigDef(sw)


##
## Vars
##

interface IVar is partial

	get ZigAssignmentNames as List<of String>?
		"""
		Return the C# names to assign to above and beyond the ZigName.
		This in support of if-inherits.
		"""


class AbstractLocalVar
	is partial

	get ZigAssignmentNames as List<of String>
		return [_backEndName]
		# return List<of String>(_useBackEndNameStack)

	get ZigName as String is override
		if _ifInheritsStack.count
			if _type.isReference
				return '(([_ifInheritsStack.peek.ZigRef])[_backEndName])'
			else
				# could it be a subclass? no. value types are structs and cannot be subclassed so this must be `if i` where `i` is nullable struct
				return '[.name].Value'  # Nullable<of T>.Value
		else
			return _backEndName
		# return _useBackEndNameStack.peek to !


class Param is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		if .type.isReference and not .type inherits NilableType
			sw.write(r'[CobraCoreInternal.NotNull] ')
		for attr in .attributes, attr.writeZigDef(sw, '', false)
		branch .direction
			on Direction.In, pass
			on Direction.InOut, sw.write('ref ')
			on Direction.Out, sw.write('out ')
		sw.write('[.type.ZigParamRef] [.ZigName]')
		if .optionalValue  # optional param
			sw.write('=')
			.optionalValue.writeZigDef(sw)

	def writeZigDefSansReferenceLabels(sw as CurlyWriter)
		"""
		Writes the parameter declaration but without C# "out" or "ref"--these are not available for
		contract methods (require_foo and ensure_foo) because contracts cannot modify arguments.
		"""
		# skip the [NotNull] as well since it's not really needed
		sw.write('[.type.ZigRef] [.ZigName]')		


class LocalVar is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		sw.write('[.type.ZigRef] [.ZigName]')
		init = .type.ZigInit
		if init.length, sw.write(' = [init]')
		sw.write(';\n')


class ResultVar
	is partial

	get ZigName as String is override
		return _backEndName


##
## Members
##


class BoxMember is partial

	var _ZigExtraIsNames as Set<of String>?

	pro ZigExtraIsNames from var
	
	get ZigThis as String
		# sigh. I wish .NET had metaclasses instead of this instance vs. static crap
		return if(.isShared, 'typeof([.parentBox.ZigName])', .parentBox.ZigThis)

	def writeZigNotNull(sw as CurlyWriter)
		if .resultType.isReference and not .resultType inherits NilableType
			sw.writeLine(r'[' + .ZigNotNullPrefix + 'CobraCoreInternal.NotNull]')

	get ZigNotNullPrefix as String
		# 2007-12-22 Writing the attribute like [return: NotNull] is problematic because MemberInfo.getCustomAttributes()
		# will not see it. At least not on Novell Mono 1.2.4. I don't know if that is a bug or a "feature".
		#return 'return: '
		return ''

	def includeZigTestDirectly as bool
		# cannot put static/shared test methods in a generic def since they cannot be invoked
		# (without computing some type args which could end up being non-trivial)
		return .compiler.includeTests and not .parentBox.isGenericDef
		
	def writeZigTest(sw as CurlyWriter)
		if _testMethods and _testMethods.count
			for tm in _testMethods, tm.writeZigDef(sw)

	def writeZigTestInvocation(sw as CurlyWriter)
		if _testMethods and _testMethods.count
			for tm in _testMethods, sw.write('[tm.ZigName]();\n')

	def writeZigParams(sw as CurlyWriter)
		.writeZigParams(sw, '()')

	def writeZigParams(sw as CurlyWriter, parens as String)
		require parens.length==2 or parens==''
		if parens.length
			sw.write(parens[0])
		sep = ''
		for param in .params
			sw.write(sep)
			param.writeZigDef(sw)
			sep = ', '
		if parens.length
			sw.write(parens[1].toString+' ')

	def writeZigIsNames(sw as CurlyWriter)
		isNameCS = {
			# only have to specify the ones that are different
			'shared': 'static',
			'nonvirtual': '',
			'readonly': 'readonly',
			'synchronized': '',
		}
		if 'synchronized' in _isNames
			sw.write('\[System.Runtime.CompilerServices.MethodImpl(System.Runtime.CompilerServices.MethodImplOptions.Synchronized)]\n')
		wroteNames = Set<of String>()
		sep = ''
		for name in _isNames
			name = isNameCS.get(name, name)
			sw.write(sep)
			sw.write(name)
			sep = ' '
			wroteNames.add(name)
		if _ZigExtraIsNames
			for name in _ZigExtraIsNames
				if name not in wroteNames
					sw.write(sep)
					sw.write(name)
					sep = ' '
		if sep.length, sw.write(' ')

	def writeZigAttribs(sw as CurlyWriter)
		for attrib in _attribs
			attrib.writeZigDef(sw)


class BoxEvent
	is partial

	get ZigName as String is override
		return .name.capitalized

	def writeZigDef(sw as CurlyWriter) is override
		base.writeZigDef(sw)
		.writeZigAttribs(sw)
		.writeZigIsNames(sw)
		sw.write('event ')
		sw.write(.handlerType.ZigRef)
		sw.write(' [.ZigName]')
		sw.write(';\n')


class BoxField is partial

	get _ZigBackEndName as String
		name = .name
		if not name.startsWith('_')
			name = name.capitalized
		return name

class BoxConst is partial

	def writeZigDef(sw as CurlyWriter) is override
		base.writeZigDef(sw)
		.writeZigAttribs(sw)
		.writeZigIsNames(sw)
		sw.write('const ')
		sw.write(_type.ZigRef)
		sw.write(' [_ZigBackEndName] = ')
		_initExpr.writeZigDef(sw)
		sw.write(';\n')


class BoxVar
	is partial

	get ZigAssignmentNames as List<of String>
		return [_ZigBackEndName]
		# return List<of String>(_useBackEndNameStack)

	get ZigName as String is override
		if _ifInheritsStack.count
			if _type.isReference
				return '(([_ifInheritsStack.peek.ZigRef])[_ZigBackEndName])'
			else
				# could it be a subclass? no. value types are structs and cannot be subclassed so this must be `if i` where `i` is nullable struct
				return '[_ZigBackEndName].Value'  # Nullable<of T>.Value
		else
			backEndName = .name
			if not backEndName.startsWith('_')
				backEndName = backEndName.capitalized
			return backEndName
			#return _backEndName
		# return _useBackEndNameStack.peek to !

	def writeZigDef(sw as CurlyWriter) is override
		base.writeZigDef(sw)
		.writeZigAttribs(sw)
		.writeZigIsNames(sw)
		sw.write(_type.ZigRef)
		sw.write(' [_ZigBackEndName]')
		if _initExpr
			sw.write(' = ')
			_initExpr.writeZigDef(sw)
		else if _canInitDefault
			ZigInit = .type.ZigInit
			if ZigInit.length
				sw.write(' = ')
				sw.write(ZigInit)
		sw.write(';\n')
		
	def _canInitDefault as bool
		# In C#, struct members can't be explicitly init'ed on declaration
		if .parentBox inherits Struct, return false
		return .type.isReference and not .type.nonNil inherits GenericParam


class AbstractMethod is partial

	get ZigGenericParams as String
		"""
		Can return, for example, '<TKey,TValue>' or ''.
		"""
		ensure ' ' not in result
		return ''

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		.compiler.codeMemberStack.push(this)
		try
			.innerWriteZigDef(sw)
		finally
			.compiler.codeMemberStack.pop

	def innerWriteZigDef(sw as CurlyWriter)
		pass
	
	def writeZigImp(sw as CurlyWriter, skipFirst as bool)
		.compiler.codeMemberStack.push(this)
		try
			sw.writeAndIndent('{\n')
			.writeZigImpHeader(sw)
			if .compiler.hasDetailedStackTraceOption, .writeDSTHead(sw)
			for param in _params, .writeZigParamCheck(param, sw)
			.writeZigLocals(sw, nil, false)
			if _requirePart and _requirePart.willGenerateCode, _requirePart.writeZigDef(sw)
			willEnsure = _ensurePart and _ensurePart.willGenerateCode
			if willEnsure
				sw.write('bool _lh_canEnsure = false;\n')
				# have to set `out` parameters or C# will error on them being passed in the `finally` for the ensure,
				# even though the _lh_canEnsure guard logically prevents problems at run-time
				for param in _params
					if param.isOut
						ZigInit = param.type.ZigInit
						if not ZigInit.length
							# TODO/HACK: yes we need something like this (or a way to convice C# that the out param reference in `finally` really is okay),
							# but it should be something less hackish, like an attribute
							ZigInit = 'DateTime.Today'
						sw.write('[param.ZigName] = [ZigInit];')
				if _backEndResultVarName.length  # set in _bindImp
					sw.write('[_returnType.ZigRef] [_backEndResultVarName]')
					if _returnType.ZigInit.length
						sw.write('= [_returnType.ZigInit]')
					sw.write(';\n')
				sw.writeAndIndent('try {\n')
			for stmt in _stmts
				if skipFirst
					skipFirst = false
					continue
				stmt.writeZigStmt(sw)
			if willEnsure
				if not stmt inherits ReturnStmt and not stmt inherits ThrowStmt
					sw.write('_lh_canEnsure = true;\n')
				sw.dedentAndWrite('} finally { // ensure\n')
				sw.indentAndWrite('if (_lh_canEnsure) {\n')
				sw.indent
				_ensurePart.writeZigDef(sw)
				sw.dedentAndWrite('}\n')
				sw.dedentAndWrite('}\n')
			if .compiler.hasDetailedStackTraceOption
				.writeDSTTail(sw)
			.writeZigImpFooter(sw)
			sw.dedent
			sw.write('}\n')
			sw.write('\n')
		finally
			.compiler.codeMemberStack.pop

	def writeZigImpHeader(sw as CurlyWriter)
		pass
		
	def writeZigImpFooter(sw as CurlyWriter)
		pass
		
	def writeZigPassArgs(sw as CurlyWriter)
		.writeZigPassArgs(sw, '()', false)

	def writeZigPassArgs(sw as CurlyWriter, parens as String, excludeOutArgs as bool)
		require parens.length==2 or parens==''
		if parens.length, sw.write(parens[0])
		sep = ''
		for param in _params
			if excludeOutArgs and param.isOut, continue
			sw.write(sep)
			sw.write(param.ZigName)
			sep = ', '
		if parens.length, sw.write(parens[1])

	def writeZigLocals(sw as CurlyWriter, locals as List<of LocalVar>?, open as bool)
		if open, sw.writeAndIndent('{\n')
		# record the `old` expressions for `ensure`
		.writeZigOldAssignments(sw)
		if locals is nil, locals = _locals
		contractsAreMethods = .compiler.options['contracts'] == 'methods'
		if locals.count
			sw.hideLineNumbers
			sw.write('// locals\n')
			try
				for local in locals
					if not local.isImplicit and not (local.isForContract and contractsAreMethods)
						local.writeZigDef(sw)
			finally
				sw.unhideLineNumbers

	def writeZigRequireParamDecls(sw as CurlyWriter)
		sep = ''
		for param in .params
			if param.isOut
				# a requirement cannot say anything useful about a parameter that is output only
				continue
			sw.write(sep)
			param.writeZigDefSansReferenceLabels(sw)  # no `inout/ref` label since a contract cannot modify reference arguments
			sep = ', '
		
	def writeZigOldAssignments(sw as CurlyWriter)
		if .isOverride and .matchingBaseMember
			(.matchingBaseMember to AbstractMethod).writeZigOldAssignments(sw)
		for oldExpr in _oldExprs
			oldExpr.writeZigAssignment(sw)

	def writeZigEnsureArgs(sw as CurlyWriter)
		if .backEndResultVarName.length
			sw.write('[.backEndResultVarName]')
			sep = [',']
		else
			sep = ['']
		_writeZigOldArgs(sw, sep)
		if .params.count
			sw.write(sep[0])
		.writeZigPassArgs(sw, '', false)  # these have to come last, because they might include a C# "params" which has to be last

	def _writeZigOldArgs(sw as CurlyWriter, sep as List<of String>)
		if .isOverride and .matchingBaseMember
			assert .matchingBaseMember is not this
			(.matchingBaseMember to AbstractMethod)._writeZigOldArgs(sw, sep)
		for oldExpr in _oldExprs
			sw.write(sep[0])
			sw.write(oldExpr.ZigVarName)
			sep[0] = ', '

	def writeZigEnsureParamDecls(sw as CurlyWriter)
		if .backEndResultVarName.length
			sw.write('[.resultType.ZigRef] [.backEndResultVarName]')
			sep = [',']
		else
			sep = ['']
		_writeZigOldParamDecls(sw, sep)
		# these have to come last, because they might include a C# "params" which has to be last
		for param in .params
			sw.write(sep[0])
			param.writeZigDefSansReferenceLabels(sw)  # no `out` or `inout/ref` labels since a contract cannot modify reference arguments
			sep[0] = ', '

	def _writeZigOldParamDecls(sw as CurlyWriter, sep as List<of String>)
		if .isOverride and .matchingBaseMember
			assert .matchingBaseMember is not this
			(.matchingBaseMember to AbstractMethod)._writeZigOldParamDecls(sw, sep)
		for oldExpr in _oldExprs
			sw.write(sep[0])
			sw.write('[oldExpr.type.ZigRef] [oldExpr.ZigVarName]')
			sep[0] = ', '

	def writeZigParamCheck(param as Param, sw as CurlyWriter)
		if .isCompilerGenerated, return
		if param.type.isReference and not param.type inherits NilableType and not param.isOut
			if .compiler.options.boolValue('include-nil-checks')
				sw.write('if (CobraCoreInternal.CobraCore._willCheckNil && [param.ZigName]==null) throw new System.ArgumentNullException("[param.name]");\n')

	def writeDSTHead(sw as CurlyWriter)
		if not .canHaveDetailedStackTrace, return
		# could be a neat option, -trace-methods, but maybe done with events:
		# sw.writeLine('Console.WriteLine(">> [.parentBox.name].[.name]");')
		sw.write('CobraCoreInternal.CobraImp.PushFrame("[.parentBox.name]", "[.name]", [Utils.ZigStringLiteralFor(.token.fullPathName)], [.token.lineNum]')
		if not .isShared
			sw.write(', "this", [.compiler.curBox.ZigThis]')
		for param in .params
			if not param.isImplicit and not param.isOut
				sw.write(', "[param.name]", [param.ZigName]')
		sw.write(');\n')
		sw.writeAndIndent('try {\n')

	def writeDSTTail(sw as CurlyWriter)
		if not .canHaveDetailedStackTrace, return
		# sw.writeLine('Console.WriteLine("<< [.parentBox.name].[.name]");')
		# this catch all clashes with yield statements. which is why .canHaveDetailedStackTrace returns false if a method has a yield statement.
		sw.dedentAndWrite('} catch {\n')
		sw.indent
		sw.write('CobraCoreInternal.CobraImp.CaughtUncaughtException();\n')
		sw.write('throw;\n')
		sw.dedentAndWrite('} finally {\n')
		sw.indent
		sw.write('CobraCoreInternal.CobraImp.PopFrame();\n')
		sw.dedentAndWrite('}\n')


class Initializer is partial

	def innerWriteZigDef(sw as CurlyWriter)
		base.innerWriteZigDef(sw)
		.writeZigAttribs(sw)
		first = if(_stmts.count, _stmts[0], nil)
		callInitializer as String? = nil
		if first inherits DotExpr
			if first.left inherits ThisOrBaseLit
				if (firstRight = first.right) inherits IDotRightExpr
					if firstRight.name == 'init'
						callInitializer = (first.left to ThisOrBaseLit).asZig
						args = firstRight.args
						Stmt.inInitCall = true
						didSetInInitCall = true
		_fixIsNames
		.writeZigIsNames(sw)
		sw.write(' [.parentBox.rootName]')
		.writeZigParams(sw)
		if callInitializer
			sw.writeAndIndent('\n')
			sw.write(': [callInitializer](')
			sep = ''
			for arg in args
				sw.write(sep)
				arg.writeZigDef(sw)
				sep = ', '
			sw.write(') ')
			sw.dedent
			if didSetInInitCall
				assert Stmt.inInitCall  # make sure it wasn't reset somewhere else
				Stmt.inInitCall = false
		.writeZigImp(sw, if(callInitializer, true, false))
		if _requirePart
			_requirePart.writeZigMethod(sw)
		if _ensurePart
			_ensurePart.writeZigMethod(sw)
		if .includeZigTestDirectly, .writeZigTest(sw)

	def _fixIsNames
		# suppress adding default access modifiers on static initializer
		# any access modifier in static ctor is error but that should have been caught in bind* methods
		#	we'll just cater to the default 'public'
		if 'shared' in _isNames and _isNames.count > 1
			_isNames.remove('public')
		
	def writeZigImpHeader(sw as CurlyWriter)
		base.writeZigImpHeader(sw)
		if .isStructMember and .compiler.options['contracts'] <> 'none'
			sw.write('\n_ih_invariantGuard = 0;\n\n')  # otherwise C# complains: Field "STRUCTNAME._ih_invariantGuard" must be fully assigned before control leaves the constructor
		

class Method
	is partial

	get ZigGenericParams as String is override
		params = .parentBox.extendedMethodGenericParams(_genericParams)
		if params.count
			sb = StringBuilder('<')
			sep = ''
			for param in params
				sb.append(sep)
				sb.append(param.ZigName)
				sep = ','
			sb.append('>')
			return sb.toString
		else
			return ''

	def innerWriteZigDef(sw as CurlyWriter)
		base.innerWriteZigDef(sw)
		.writeZigNotNull(sw)
		.writeZigAttribs(sw)
		name = .ZigName
		returnType = _returnType ? .compiler.voidType
		if _implementsType
			name = _implementsType.ZigRef + '.' + name
		.writeZigIsNames(sw)
		sw.write('[returnType.ZigRef] [name][.ZigGenericParams]')
		.writeZigParams(sw)
		if .genericParams.count
			sw.indent
			for param in .genericParams
				if param inherits GenericParam
					param.writeZigConstraint(sw)
			sw.dedent
		if not .parentBox.canHaveStatements
			sw.write(';\n')
		else
			if .bodyExclusion, sw.writeLine(';')
			else, .writeZigImp(sw, false)
			if _requirePart, _requirePart.writeZigMethod(sw)
			if _ensurePart, _ensurePart.writeZigMethod(sw)
			if .includeZigTestDirectly, .writeZigTest(sw)

	def writeZigImpHeader(sw as CurlyWriter)
		base.writeZigImpHeader(sw)
		if .isMain
			if .compiler.hasExceptionReportOption
				sw.writeLine('try { // Exception Report')
				sw.indent
			else if .compiler.options.boolValue('debugging-tips')
				sw.writeLine('try { // -debugging-tips')
				sw.indent
		if .isMain and .compiler.options.boolValue('include-tests')
			(.compiler to Compiler).writeZigRunAllTests(sw)

	def writeZigImpFooter(sw as CurlyWriter)
		base.writeZigImpFooter(sw)
		if .isMain
			if .compiler.hasExceptionReportOption
				sw.dedent
				sw.writeLine('} catch (System.Exception _lh_exceptionReportException) { CobraCoreInternal.CobraCore.HandleUnhandledException(_lh_exceptionReportException); }')
			else if .compiler.options.boolValue('debugging-tips')
				sw.dedent
				sw.writeLine('} catch { CobraCoreInternal.CobraCore.PrintDebuggingTips(); throw; }')
				
	get ZigName as String is override
		return .name.capitalized


class ProperDexer
	is partial

	def writeZigBody(sw as CurlyWriter)
		sw.write(' {\n')
		sw.indent
		if _getPart
			if .isAbstract or not .parentBox.canHaveStatements
				sw.write('\tget;\n')
			else
				_getPart.writeZigDef(sw)
		if _setPart
			if .isAbstract or not .parentBox.canHaveStatements
				sw.write('\tset;\n')
			else
				_setPart.writeZigDef(sw)
		sw.dedent
		sw.write('}\n')


class ProperDexerXetter
	is partial

	def innerWriteZigDef(sw as CurlyWriter)
		base.innerWriteZigDef(sw)
		sw.write(.xetPartName)
		.writeZigImp(sw, false)


class Property
	is partial

	get ZigNotNullPrefix as String is override
		return ''

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		sw.writeLine('')
		.writeZigNotNull(sw)
		.writeZigAttribs(sw)
		.writeZigIsNames(sw)
		sw.write(' [_returnType.ZigRef] [.name.capitalized]')
		.writeZigBody(sw)
		getPart = .getPart
		if getPart
			.compiler.codeMemberStack.push(getPart)
			try
				if getPart.requirePart
					getPart.requirePart.writeZigMethod(sw)
				if getPart.ensurePart
					getPart.ensurePart.writeZigMethod(sw)
			finally
				.compiler.codeMemberStack.pop
		setPart = .setPart
		if setPart
			.compiler.codeMemberStack.push(setPart)
			try
				if setPart.requirePart
					setPart.requirePart.writeZigMethod(sw)
				if setPart.ensurePart
					setPart.ensurePart.writeZigMethod(sw)
			finally
				.compiler.codeMemberStack.pop
		if .includeZigTestDirectly, .writeZigTest(sw)


class Indexer
	is partial

	get ZigNotNullPrefix as String is override
		return ''

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		assert _name==r'[]'
		sw.writeLine('')
		.writeZigNotNull(sw)
		.writeZigAttribs(sw)
		.writeZigIsNames(sw)
		sw.write(' [_returnType.ZigRef] this')
		.writeZigParams(sw, r'[]')
		.writeZigBody(sw)
		getPart = .getPart
		if getPart
			.compiler.codeMemberStack.push(getPart)
			try
				if getPart.requirePart
					getPart.requirePart.writeZigMethod(sw)
				if getPart.ensurePart
					getPart.ensurePart.writeZigMethod(sw)
			finally
				.compiler.codeMemberStack.pop
		setPart = .setPart
		if setPart
			.compiler.codeMemberStack.push(setPart)
			try
				if setPart.requirePart
					setPart.requirePart.writeZigMethod(sw)
				if setPart.ensurePart
					setPart.ensurePart.writeZigMethod(sw)
			finally
				.compiler.codeMemberStack.pop
		if .includeZigTestDirectly, .writeZigTest(sw)


class MemberOverload
	is partial

	pass


class TestMethod is partial

	get ZigName as String is override
		if _forMember
			name = 'test_' + _forMember.name.capitalized.replace('Cue.', '_cue_')
			if .overloadId <> -1
				name += '_ol_[.overloadId]'
		else
			name = 'test_[_forBox.ZigKeyWord]_'+_forBox.ZigNameComponent
		return '[name]_[.serialNum]'  # embed serial number because there can be multiple test sections


class ContractPart
	is partial

	var _ZigMethodNameCache as String?

		
	def writeZigMethod(sw as CurlyWriter) is abstract

	def _ZigMethodName(prefix as String) as String
		if _ZigMethodNameCache is nil
			# TODO: having the serial number in the name avoids problem with overloads, but it's ugly and it can change from run-to-run.
			# 		would be nice if each member of an overload had an overload number.
			name = '[prefix]_[_codeMember.ZigName][_codeMember.ZigGenericParams]_[_codeMember.serialNum]_[_codeMember.parentBox.name]'
			name = name.replace(r'[]', 'Item') # indexer # TODO: maybe Indexer should return 'Item' in the first place
			# properindexers like "name.get" have a '.'
			# generics have < > and ,
			for ch in [c'.', c'<', c'>', c',']
				name = name.replace(ch, c'_')
			_ZigMethodNameCache = name
		return _ZigMethodNameCache to !

	get ZigThis as String
		return _codeMember.ZigThis


class RequirePart
	is partial


	get ZigMethodName as String
		return _ZigMethodName('require')

	def writeZigDef(sw as CurlyWriter) is override
		base.writeZigDef(sw)
		assert .willGenerateCode
		willInline = .willInlineCode
		sw.write('if (CobraCoreInternal.CobraCore._willCheckRequire) {\n')
		sw.indent
		if _codeMember.isOverride
			# Note that in Cobra, when the top level class does not define `require` then that is the
			# same as saying `require true`--there is no requirement for calling the method. But when
			# an overriding method does not define `require` then it is inheriting the `require` of
			# its matching base method.
			curCodeMember = _codeMember to ?
			count = 0
			n = 1
			post while curCodeMember
				if not curCodeMember.parentBox.isExtern and curCodeMember.requirePart and (not curCodeMember.requirePart.isImplicit or curCodeMember.matchingBaseMember is nil)
					count += 1
					sw.write('try {\n')
					sw.indent
					if willInline
						if curCodeMember.requirePart.exprs.count
							willEncapsulate = curCodeMember is not _codeMember
							if willEncapsulate
								# parameter names can be different
								sw.write('{\n')
								sw.indent
								for i = 0 .. _codeMember.params.count
									ourParam = _codeMember.params[i]
									ancestorParam = curCodeMember.params[i]
									if ourParam.name <> ancestorParam.name  # this is the problem`; name mismatch
										sw.write('[ourParam.type.ZigRef] [ancestorParam.name] = [ourParam.name];\n')
							curCodeMember.requirePart.writeZigChecks(sw)
							if willEncapsulate
								sw.dedent
								sw.write('}\n')
					else
						sw.write('[curCodeMember.requirePart.ZigMethodName]')
						_codeMember.writeZigPassArgs(sw, '()', true)  # always use *our* code member since the arg names can be different than base classes
						sw.write(';\n')
					sw.dedent
					sw.write('} catch (CobraCoreInternal.RequireException re[n]) {\n')
					sw.indent
					if n>1
						sw.write('re[n-1].Next = re[n];\n')
					n += 1
				curCodeMember = curCodeMember.matchingBaseMember to AbstractMethod?
			# at this point in C# code, all requirements have failed
			if n > 1
				sw.write('throw re1;\n')
			for m = 1 .. n
				sw.dedent
				sw.write('}\n')
				count -= 1
		else
			if willInline
				.writeZigChecks(sw)
			else
				sw.write('[.ZigMethodName]')
				_codeMember.writeZigPassArgs(sw, '()', true)
				sw.write(';\n')
		sw.dedent
		sw.write('}\n')

	def writeZigMethod(sw as CurlyWriter) is override
		if .compiler.options['contracts'] <> 'methods'
			return
		if _codeMember.isInterfaceMember
			# contracts on interface members are not supported yet
			# and when they are, these methods will have to be written outside the interface
			return
		if not .willGenerateCode
			return
		static = if(_codeMember.isShared, 'static ', '')
		access = if(_codeMember.parentBox inherits Struct, 'private', 'protected')
		sw.write('[static][access] void [.ZigMethodName][_codeMember.ZigGenericParams](')
		_codeMember.writeZigRequireParamDecls(sw)
		sw.write(') {\n')
		sw.indent
		for local in .codeMember.locals, if local.isForRequire, local.writeZigDef(sw)
		.writeZigChecks(sw)
		sw.dedent
		sw.write('}\n\n')

	def writeZigChecks(sw as CurlyWriter)
		for expr in _exprs
			sw.write('if (!')
			expr.writeZigDef(sw)
			sw.write(') ')
			sw.indent
			sw.write('throw new CobraCoreInternal.RequireException([expr.ZigSourceSite], ')
			expr.writeZigBreakdown(sw)
			sw.write('[.ZigThis], null);\n')
			sw.dedent


class EnsurePart is partial

	get ZigMethodName as String
		return _ZigMethodName('ensure')

	def writeZigDef(sw as CurlyWriter) is override
		base.writeZigDef(sw)
		assert .willGenerateCode
		willInline = .willInlineCode
		sw.write('if (CobraCoreInternal.CobraCore._willCheckEnsure) {\n')
		sw.indent
		if _codeMember.isOverride
			curCodeMember = _codeMember to ?
			post while curCodeMember
				if not curCodeMember.parentBox.isExtern and curCodeMember.ensurePart
					if willInline
						curCodeMember.ensurePart.writeZigChecks(sw)
					else
						sw.write('[curCodeMember.ensurePart.ZigMethodName](')
						_codeMember.writeZigEnsureArgs(sw)
						sw.write(');\n')
				curCodeMember = curCodeMember.matchingBaseMember to AbstractMethod?  # TODO: should a cast really be needed here?
			# at this point in C# code, all ensure have passed
		else
			if willInline
				.writeZigChecks(sw)
			else
				sw.write('[_codeMember.ensurePart.ZigMethodName](')
				_codeMember.writeZigEnsureArgs(sw)
				sw.write(');\n')
		sw.dedent
		sw.write('}\n')

	def writeZigMethod(sw as CurlyWriter) is override
		if .compiler.options['contracts'] <> 'methods'
			return
		if _codeMember.isInterfaceMember
			# contracts on interface members are not supported yet
			# and when they are, these methods will have to be written outside the interface
			return
		if not .willGenerateCode
			return
		static = if(_codeMember.isShared, 'static ', '')
		access = if(_codeMember.parentBox inherits Struct, 'private', 'protected')
		sw.write('[static][access] void [.ZigMethodName][_codeMember.ZigGenericParams](')
		_codeMember.writeZigEnsureParamDecls(sw)
		sw.write(') {\n')
		sw.indent
		for local in .codeMember.locals, if local.isForEnsure, local.writeZigDef(sw)
		.writeZigChecks(sw)
		sw.dedent
		sw.write('}\n\n')

	def writeZigChecks(sw as CurlyWriter)
		for expr in _exprs
			sw.write('if (!')
			expr.writeZigDef(sw)
			sw.write(') ')
			sw.indent
			sw.write('throw new CobraCoreInternal.EnsureException([expr.ZigSourceSite], ')
			expr.writeZigBreakdown(sw)
			sw.write('[.ZigThis], null);\n')
			sw.dedent
		if not _codeMember.isShared and not _codeMember.isExtensionMember
			sw.write('if (CobraCoreInternal.CobraCore._willCheckInvariant && _ih_invariantGuard == 0) {\n')
			sw.indent
			sw.write('_ih_invariantGuard += 1;\n')
			sw.write('try {\n')
			sw.indent
			if .willInlineCode
				.codeMember.parentBox.writeAllZigInvariantChecks(sw)
			else
				sw.write('invariant_[_codeMember.parentBox.rootName]();')
			sw.dedent
			sw.write('} finally { _ih_invariantGuard -= 1; }\n')
			sw.dedent
			sw.write('} // invariant\n')


##
## Statements
##

class Stmt is partial

	def ZigSourceSite as String
		"""
		Returns a C# "new SourceSite(...)" expression with the correct arguments for the current code generation.
		"""
		if .compiler.codeMemberStack.count
			codeMember = .compiler.curCodeMember
			return .ZigSourceSite(codeMember.parentBox.name, codeMember.name, .ZigThis)
		else
			# example: var _x = someExpr ...
			return .ZigSourceSite(.compiler.curBox.name, .compiler.curBoxMember.name, .ZigThis)
		
	def ZigSourceSite(boxName as String, memberName as String, ZigThis as String) as String
		"""
		Returns a C# "new SourceSite(...)" expression with the correct arguments for the current code generation.
		The arguments to this method allow for some explicit control in special circumstances, such as `invariant`.
		"""
		require
			boxName.length
			memberName.length
			ZigThis.length
		body
			return 'new CobraCoreInternal.SourceSite([.ZigSourceSiteArgs(boxName, memberName, ZigThis)])'

	def ZigSourceSiteArgs as String
		return .ZigSourceSiteArgs(.compiler.curBox.name, .compiler.curBoxMember.name, .ZigThis)
	
	def ZigSourceSiteArgs(boxName as String, memberName as String, ZigThis as String) as String
		require
			boxName.length
			memberName.length
			ZigThis.length
		body
			boxName = Utils.ZigStringLiteralFor(boxName)
			memberName = Utils.ZigStringLiteralFor(memberName)
			tok = .token
			fileName = tok.fileName
			if not Path.isPathRooted(fileName)
				fileName = Path.combine(Environment.currentDirectory, fileName)
			fileName = Utils.ZigStringLiteralFor(fileName)
			return '[fileName], [tok.lineNum], [boxName], [memberName], [ZigThis]'
	
	get ZigThis as String
		if _inInitCall  # C# won't allow 'this' in a base constructor call
			return '"(uninitialized [.compiler.curBox.name] instance)"'
		else if .compiler.codeMemberStack.count
			return .compiler.curCodeMember.ZigThis
		else
			assert .compiler.boxMemberStack.count
			# so not a code member
			return '"(uninitialized [.compiler.curBox.name] instance)"'

	def writeZigSetLine(sw as CurlyWriter)
		if _canSetLine and .token.lineNum > 0
			sw.write('CobraCoreInternal.CobraImp._curFrame._lineNum = [.token.lineNum];\n')

	def writeZigStmt(sw as CurlyWriter)
		require .didBindImp
		sw.node(this)
		.writeZigSetLine(sw)
		.writeZigDef(sw)


class AssertStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		if not .compiler.options.boolValue('include-asserts')
			return
		sw.write('if (CobraCoreInternal.CobraCore._willCheckAssert && !')
		_expr.writeZigDef(sw)
		sw.write(') \n')  # \n for improved readability of the generated code
		sw.indent
		sw.write('throw new CobraCoreInternal.AssertException([.ZigSourceSite], ')
		_expr.writeZigBreakdown(sw)
		sw.write('[.ZigThis], ')
		if _info
			_info.writeZigDef(sw)
		else
			sw.write('null')
		sw.write(');\n')
		sw.dedent


class BranchStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		if _expr.type.isDynamic
			# if the expression is dynamic, then use an if-else ladder with CobraImp.Equals(
			sw.writeLine('// branch [_expr.toCobraSource]')
			
			varName = '_lh_branch_[.serialNum]'
			sw.write('[_expr.type.ZigRef] [varName] = ')
			_expr.writeZigDef(sw)
			sw.writeLine(';')
						
			elseWord = ''
			for onPart in _onParts
				sw.write('[elseWord]if (')
				sep = ''
				for e in onPart.exprs
					sw.write(sep)
					sw.write('CobraCoreInternal.CobraImp.Equals([varName], ')
					e.writeZigDef(sw, false)
					sw.write(')')
					sep = ' || '
				sw.write(')')
				onPart.block.writeZigDef(sw)
				elseWord = 'else '
			if _elsePart
				sw.write('else ')
				_elsePart.writeZigDef(sw)
		else
			# for any other kind of expression, use a C# switch
			sw.write('switch(')
			_expr.writeZigDef(sw)
			sw.write(') {\n')
			sw.indent
			for onPart in _onParts
				sep = ''
				for e in onPart.exprs
					sw.write(sep)
					sw.write('case ')
					e.writeZigDef(sw)
					sw.write(': ')
					sep = '\n'
				onPart.block.writeZigDef(sw)
				if not onPart.block.stmts.count or not onPart.block.stmts[onPart.block.stmts.count-1] inherits ReturnStmt  # CC: use .last
					sw.write('break;\n')
			if _elsePart
				sw.write('default: ')
				_elsePart.writeZigDef(sw)
				sw.write('break;\n')
			sw.dedent
			sw.write('}\n')


class BlockStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		.writeZigDef(sw, true, nil)

	def writeZigDef(sw as CurlyWriter, close as bool)
		.writeZigDef(sw, close, nil)

	def writeZigDef(sw as CurlyWriter, top as String?)
		.writeZigDef(sw, true, top)

	def writeZigDef(sw as CurlyWriter, close as bool, top as String?)
		sw.node(this)
		sw.write(' {\n')
		sw.indent
		if top
			sw.write(top)
		if _ifInheritsVar
			#typeName = _ifInheritsType.ZigRef
			#newName = '_lh_' + _ifInheritsVar.name + '_' + _ifInheritsType.ZigNameComponent
			#sw.write('[typeName] [newName] = ([typeName])[_ifInheritsVar.ZigName];\n')
			#_ifInheritsVar.useBackEndNameStack.push(newName)
			ifInheritsCount = _ifInheritsVar.ifInheritsStack.count  # AssignExpr could pop our _ifInheritsType. We detect that with the count.
			_ifInheritsVar.ifInheritsStack.push(_ifInheritsType)
		for stmt in _stmts
			stmt.writeZigStmt(sw)
		if _ifInheritsVar and _ifInheritsVar.ifInheritsStack.count > ifInheritsCount
			#_ifInheritsVar.useBackEndNameStack.pop
			_ifInheritsVar.ifInheritsStack.pop
		if close
			sw.dedent
			sw.write('}\n')


class BreakStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		sw.write('break;\n')


class ContinueStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		sw.write('continue;\n')


class ExpectStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		exceptionTypeRef = _exceptionType.ZigRef
		gotRightExceptionVarName = '_lh_expect_[_varNumber-1]'  # lh => "local helper"
		sw.write('bool [gotRightExceptionVarName] = false;\n')
		sw.write('try ')
		_block.writeZigDef(sw)
		sw.writeAndIndent('catch ([exceptionTypeRef]) {\n')
		sw.write('// exactly what is expected\n')
		sw.write('[gotRightExceptionVarName] = true;\n')
		sw.dedentAndWrite('}\n')
		if _exceptionType inherits Box and not (_exceptionType to Box).isClrSystemExceptionClass
			wrongExceptionVarName = '_lh_expect_[_varNumber]'
			assert gotRightExceptionVarName <> wrongExceptionVarName
			sw.writeAndIndent('catch (System.Exception [wrongExceptionVarName]) {\n')
			sw.write('throw new CobraCoreInternal.ExpectException(typeof([exceptionTypeRef]), [wrongExceptionVarName]);\n')
			sw.dedentAndWrite('}\n')
		sw.write('if (![gotRightExceptionVarName]) throw new CobraCoreInternal.ExpectException(typeof([exceptionTypeRef]), null);\n')


class ForStmt
	is partial

	pass
	

class OldForNumericStmt
	is partial


	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		csVar = _var.ZigName
		trackLocals = .compiler.willTrackLocals
		if trackLocals
			sw.write('for (CobraCoreInternal.CobraImp.SetLocal("[.var.name]", [csVar]=')
		else
			sw.write('for ([csVar]=')
		_start.writeZigDef(sw)
		if trackLocals
			sw.write(')')
		if _var.type.isDynamic
			sw.write('; CobraCoreInternal.CobraImp.DynamicCompare([csVar], ')
			_stop.writeZigDef(sw, false)
			sw.write(')[if(_dir==1, "<", ">")]0')
			opName = if(_dir==1, 'op_Addition', 'op_Subtraction')
			sw.write('; [csVar]=CobraCoreInternal.CobraImp.DynamicOp("[opName]", [csVar], ')
			if _step
				_step.writeZigDef(sw, false)
			else
				sw.write('1')
			sw.write(')')
		else
			sw.write('; [csVar]')
			sw.write(if(_dir==1, '<', '>'))
			_stop.writeZigDef(sw)
			sw.write('; ')
			if _step
				if _dir==1
					sw.write('[csVar]+=')
				else
					sw.write('[csVar]-=')
				_step.writeZigDef(sw)
			else
				if _dir==1
					sw.write('[csVar]++')
				else
					sw.write('[csVar]--')
		sw.write(')')
		_block.writeZigDef(sw)


class ForNumericStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		if _var.type.isDynamic
			_writeZigDefForDynamic(sw)
		else
			_writeZigDefForStatic(sw)
	
	def _writeZigDefForDynamic(sw as CurlyWriter)
		# TODO: this is the old numeric for loop behavior. 
		csVar = _var.ZigName
		trackLocals = .compiler.willTrackLocals
		if trackLocals
			sw.write('for (CobraCoreInternal.CobraImp.SetLocal("[.var.name]", [csVar]=')
		else
			sw.write('for ([csVar]=')
		_start.writeZigDef(sw)
		if trackLocals
			sw.write(')')
		sw.write('; CobraCoreInternal.CobraImp.DynamicCompare([csVar], ')
		_stop.writeZigDef(sw, false)
		sw.write(')[if(_dir==1, "<", ">")]0')
		opName = if(_dir==1, 'op_Addition', 'op_Subtraction')
		sw.write('; [csVar]=CobraCoreInternal.CobraImp.DynamicOp("[opName]", [csVar], ')
		if _step
			_step.writeZigDef(sw, false)
		else
			sw.write('1')
		sw.write(')')
		sw.write(')')
		_block.writeZigDef(sw)

	def _writeZigDefForStatic(sw as CurlyWriter)
		"""
		Pseudo example:
			Cobra:
				for x in start : stop : step
					statements
			C#:
				{
				type _lh_start_1 = start;
				type _lh_stop_2 = stop;
				type _lh_step_3 = step;
				int _lh_dir_4 = (_lh_stop_2 - _lh_start_1) < 0 ? -1 : +1;
				for (x = start; (_lh_dir_4==-1) ? x > stop : x < stop; x += step) {
					statements
				}
				}
		Note that it's important that the C# code gen uses a for() loop so that
		the "continue" statement still increments the control variable.
		
		In the case that the 'stop' or 'step' are integer literals, no variables are needed for them.
		TODO: If 'stop' or 'step' are const or readonly, same thing.
		"""
		trackLocals = .compiler.willTrackLocals
		sw.write('{ // for [.var.name] in [.start.toCobraSource] : [.stop.toCobraSource]' + if(.step, ' : [.step.toCobraSource]', '') + '\n')
		ZigVar = _var.ZigName
		ZigStart = '_lh_start_[.serialNum]'
		ZigStop = '_lh_stop_[.serialNum]'
		ZigStep = '_lh_step_[.serialNum]'
		ZigDir = '_lh_dir_[.serialNum]'
		ZigType = _var.type.ZigRef

		sw.write('[ZigType] [ZigStart] = ')
		.start.writeZigDef(sw)
		sw.write(';\n')
		
		if .stop inherits IntegerLit
			ZigStop = (.stop to IntegerLit).asZig
		else
			sw.write('[ZigType] [ZigStop] = ')
			.stop.writeZigDef(sw)
			sw.write(';\n')

		isSimpleStep = false
		step = .step
		if step is nil
			ZigStep = '1'
			isSimpleStep = true
		else if step inherits IntegerLit
			ZigStep = step.asZig
			isSimpleStep = step.valueAsInt > 0
		else
			sw.write('[ZigType] [ZigStep] = ')
			step.writeZigDef(sw)
			sw.write(';\n')

		if not isSimpleStep
			sw.write('int [ZigDir] = [ZigStep] < 0 ? -1 : +1;\n')

		sw.write('for(')
		if trackLocals
			sw.write('CobraCoreInternal.CobraImp.SetLocal("[.var.name]", [ZigVar] = [ZigStart])')
		else
			sw.write('[ZigVar] = [ZigStart]')		
		if isSimpleStep
			sw.write('; [ZigVar] < [ZigStop] ; ')
		else
			sw.write('; ([ZigDir]==1) ? [ZigVar] < [ZigStop] : [ZigVar] > [ZigStop]; ')
		if trackLocals
			sw.write('CobraCoreInternal.CobraImp.SetLocal("[.var.name]", [ZigVar] += [ZigStep])')
		else
			sw.write('[ZigVar] += [ZigStep]')		
		sw.write(') ')

		_block.writeZigDef(sw, false)

		sw.dedent
		sw.write('}\n')
		sw.write('} // for [.var.name]\n')


class ForEnumerableStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		# in a C# foreach, (1) you must declare a new variable, (2) you cannot reassign it and (3) you cannot access it after the loop
		# these constraints don't exist in Cobra
		helperName = '_lh_for_[_var.name]_[_varNumber]'
		sw.write('foreach ([_var.type.ZigRef] [helperName] in ')

		# TODO: the ZigRef of a type is not qualified and there is no using System.Collections;
		# _what.writeZigDefInContext(sw, false)
		if _what.type.isDynamic
			sw.write('CobraCoreInternal.CobraImp.GetEnumerable(')
			_what.writeZigDef(sw, false)
			sw.write(')')
		else
			_what.writeZigDef(sw, false)

		sw.write(')')
		stmt = '[.var.ZigName] = [helperName]'
		if .compiler.willTrackLocals
			stmt = 'CobraCoreInternal.CobraImp.SetLocal("[.var.name]", [stmt])'
		stmt += ';\n'
		_block.writeZigDef(sw, stmt)


class IfStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		# if you're looking for if-inherits related code gen, see BlockStmt
		base.writeZigDef(sw)
		sw.write('if (')
		_cond.writeZigDef(sw, false)
		sw.write(')')
		_trueStmts.writeZigDef(sw, false)
		sw.dedent
		if _falseStmts
			sw.write('} else')
			_falseStmts.writeZigDef(sw, false)
			sw.dedent
		sw.write('}\n')


class ListenOrIgnoreStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		_event.writeZigDef(sw, false)
		sw.write(' [.ZigOperator] ')
		_target.writeZigDef(sw, false)
		sw.writeLine(';')

	get ZigOperator as String is abstract


class ListenStmt
	is partial

	get ZigOperator as String is override
		return '+='


class IgnoreStmt
	is partial

	get ZigOperator as String is override
		return '-='


class LockStmt is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		sw.write('lock (')
		_expr.writeZigDef(sw, false)
		sw.write(')')
		_block.writeZigDef(sw)


class PassStmt
	is partial

	pass


class PrintStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		if _destination
			_destination.writeZigDef(sw, true)
			methodName = if(_stop, 'Write', 'WriteLine')
			sw.write('.[methodName](')
		else
			methodName = if(_stop, 'PrintStop', 'PrintLine')
			sw.write('CobraCoreInternal.CobraImp.[methodName](')
		sep = ''
		for arg in _args
			sw.write('[sep]CobraCoreInternal.CobraImp._printStringMaker.MakeString(')
			arg.writeZigDef(sw)
			sw.write(')')
			sep = '+" "+'
		sw.writeLine(');')


class PrintRedirectStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		sw.write('CobraCoreInternal.CobraImp.PushPrintTo(')
		_destination.writeZigDef(sw, false)
		sw.write(');\n')
		sw.write('try')
		_block.writeZigDef(sw)
		sw.write('finally {\n')
		sw.indent
		sw.write('CobraCoreInternal.CobraImp.PopPrintTo();\n')
		sw.dedent
		sw.write('}\n')


class RaiseStmt is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		name = .name.capitalized
		localName = '_lh_event_[.serialNum]'
		sw.writeLine('// raise [.name] ...')
		this_ = if(_definition and _definition.isShared, '', 'this.')
		sw.write('{ [_eventType.ZigRef] [localName] = [this_][name]; if ([localName]!=null) [localName](')
		sep = ''
		for expr in _args
			sw.write(sep)
			expr.writeZigDef(sw, false)
			sep = ', '
		sw.write('); }\n')


class ReturnStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		ensurePart = .compiler.curCodeMember.ensurePart
		willEnsure = ensurePart and ensurePart.willGenerateCode
		if willEnsure
			sw.write('_lh_canEnsure = true;\n')
		if _expr
			if willEnsure and _backEndResultVarName and _backEndResultVarName.length
				sw.write('return [_backEndResultVarName]=')
				_expr.writeZigDefInContext(sw)
				sw.write(';\n')
			else
				sw.write('return ')
				_expr.writeZigDefInContext(sw, false)
				sw.write(';\n')
		else
			sw.write('return;\n')


class TraceStmt
	is partial

	pass


class TraceLocationStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		if .includeTraces
			sw.write('CobraCoreInternal.CobraCore.Tracer.Trace([.ZigSourceSite]);\n')


class TraceAllStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		if .includeTraces
			sw.write('CobraCoreInternal.CobraCore.Tracer.Trace([.ZigSourceSite], "this", [_codePart.ZigThis]')
			for param in _codePart.params
				sw.write(', "[param.name]", [param.ZigName]')
			for local in _codePart.locals
				sw.write(', "[local.name]", [local.ZigName]')
			sw.write(');\n')


class TraceExprsStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		if .includeTraces
			sw.write('CobraCoreInternal.CobraCore.Tracer.Trace([.ZigSourceSite]')
			sep = ', '
			for expr in _exprs
				sw.write('[sep][Utils.ZigStringLiteralFor(expr.toCobraSource)][sep]')
				expr.writeZigDef(sw, false)
			sw.write(');\n')


class TryStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		if _successBlock
			# C# has no "success" (or in Python, "else") block for the "try" statement
			# so it has to be simulated
			helperName = '_lh_success_[_varNumber]'
			sw.write('bool [helperName] = true;\n')
			if _finallyBlock
				sw.write('try {\n')
				sw.indent
			sw.write('try')
			_tryBlock.writeZigDef(sw, false)
			sw.dedent
			sw.write('}\n')
			if _catchBlocks.count
				.writeCatchBlocks(sw, helperName)

			sw.write('finally { if ([helperName])')
			_successBlock.writeZigDef(sw)
			sw.write('}\n')

			if _finallyBlock
				sw.dedent
				sw.write('}\n')
				sw.write('finally')
				_finallyBlock.writeZigDef(sw)
		else
			sw.write('try')
			_tryBlock.writeZigDef(sw)
			.writeCatchBlocks(sw, nil)
			if _finallyBlock
				sw.write('finally')
				_finallyBlock.writeZigDef(sw)

	def writeCatchBlocks(sw as CurlyWriter, localSuccessVar as String?)
		for eb in _catchBlocks
			sw.write('catch')
			if eb.type
				sw.write(' ([eb.type.ZigRef]')
				if eb.varName
					helperName = eb.ZigHelperName
					sw.write(' [helperName]')
				sw.write(')')
			sb = StringBuilder()
			if localSuccessVar
				sb.append('[localSuccessVar] = false;\n')
			if .compiler.hasDetailedStackTraceOption
				sb.append('CobraCoreInternal.CobraImp.HandledException();\n')
			if eb.varName
				trackLocals = .compiler.willTrackLocals
				if trackLocals
					sb.append('CobraCoreInternal.CobraImp.SetLocal("[eb.varName]", ')
				sb.append('[eb.ZigVarName] = [helperName]')
				if trackLocals
					sb.append(')')
				sb.append(';\n')
			eb.block.writeZigDef(sw, sb.toString)


class CatchBlock
	is partial

	var _ZigHelperName as String?

	get ZigHelperName from var

	get ZigVarName as String
		return _var.ZigName


class ThrowStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		sw.write('throw ')
		if _expr
			if _expr.type.isDynamic
				sw.write('((System.Exception)')
			_expr.writeZigDef(sw, false)
			if _expr.type.isDynamic
				sw.write(')')
		sw.write(';\n')


class UsingStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		name = _var.ZigName
		sw.write('// using\n')
		sw.write('[name] = ')
		_initExpr.writeZigDef(sw)
		sw.write(';\ntry')
		_block.writeZigDef(sw)
		sw.write('finally {\n')
		sw.indent
		if _var.type.isReference
			sw.write('if ([name]!=null) { ((System.IDisposable)[name]).Dispose(); [name] = null; }\n')
		else
			sw.write('((System.IDisposable)[name]).Dispose();\n')
		sw.dedentAndWrite('}\n')


class WhileStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		sw.write('while (')
		_expr.writeZigDef(sw, false)
		sw.write(')')
		_block.writeZigDef(sw)


class PostWhileStmt
	is partial

	def writeZigDef(sw as CurlyWriter) is override
		# base.writeZigDef(sw) - don't generate the other form of while loop
		sw.write('do')
		_block.writeZigDef(sw, false)
		sw.dedent
		sw.write('} while (')
		_expr.writeZigDef(sw, false)
		sw.write(');\n')


class YieldStmt
	is partial

	pass


class YieldBreakStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		sw.write('yield break;\n')


class YieldReturnStmt
	is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		ensurePart = .compiler.curCodeMember.ensurePart
		willEnsure = ensurePart and ensurePart.willGenerateCode
		if willEnsure
			sw.write('_lh_canEnsure = true;\n')
		if _expr
			backEndResultVarName = .compiler.curCodeMember.backEndResultVarName
			if willEnsure and backEndResultVarName.length
				# TODO: resolve yield return with ensure
				# sw.write('yield return [backEndResultVarName]=')
				# so for now:
				sw.write('yield return ')
				_expr.writeZigDefInContext(sw)
				sw.write(';\n')
			else
				sw.write('yield return ')
				_expr.writeZigDefInContext(sw)
				sw.write(';\n')
		else
			sw.write('yield return;\n')


class MultiTargetAssignStatement is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		if _rightValues
			sw.write('{ // multi-assign \n')
			nums = List<of int>()
			for value in _rightValues
				# .bindImp is called on the .block and if transformations
				# happen, the assignment statements in the block will be
				# updated rather that in _rightValues, hence this check:
				if value.transformedTo, value = value.transformedTo to Expr
				num = .compiler.curBox.makeNextPrivateSerialNumber
				sw.write('[value.type.ZigRef] lh_rvalue_[num] = ')
				value.writeZigDef(sw, false)
				sw.write(';\n')
				nums.add(num)			
			for i in _rightValues.count
				assign = _block.stmts[i] to AssignExpr
				assign.writeZigDefWithRight(sw, false)  # false = do not write right side
				sw.write('lh_rvalue_[nums[i]];\n')
			sw.write('}\n')
		else
			_block.writeZigDef(sw)

##
## Expressions
##


class Expr
	is partial

	def needsContextCast as bool
		"""
		Returns true if this expression needs to be cast within its context.
		One example, is that a dynamically typed expression requires such casting.
		"""
		type = .type
		if type.isDynamic, return true
		if type inherits IntType
			if type.size < 32, return true
		return false

	def writeZigDefInContext(sw as CurlyWriter)
		.writeZigDefInContext(sw, true)

	def writeZigDefInContext(sw as CurlyWriter, parens as bool)
		"""
		When an expression is used where a particular type is expected, such as:
			# assignment
			x = y
			# argument passing
			obj.foo(x, y)
			obj[x, y]
		it may need C# typecasting--particularly if it is dynamic typed expression.
		This method relies on having had its .contextType set beforehand.
		This method should be invoked instead of `writeZigDef` in any situation where .contextType was set.
		"""
		cast = _contextType and .needsContextCast
		if cast
			if parens, sw.write('(')
			sw.write('([_contextType.ZigRef])(')
		.writeZigDef(sw)
		if cast
			sw.write(')')
			if parens, sw.write(')')

	def writeZigDef(sw as CurlyWriter) is override
		base.writeZigDef(sw)
		branch .direction
			on Direction.In,    pass
			on Direction.Out,   sw.write('out ')
			on Direction.InOut, sw.write('ref ')
		.writeZigDef(sw, true)

	def writeZigDef(sw as CurlyWriter, parens as bool)
		pass

	def writeZigStmt(sw as CurlyWriter) is override
		assert .didBindImp
		sw.node(this)
		.writeZigSetLine(sw)
		.writeZigDef(sw, false)
		sw.write(';\n')

	def writeZigBreakdown(sw as CurlyWriter)
		sw.write(r'new object[] { 0')
		.writeZigBreakdownItems(sw)
		sw.write('}, ')

	get willWriteZigBreakdownItems as bool
		return _direction <> Direction.Out

	def writeZigBreakdownItems(sw as CurlyWriter)
		if .willWriteZigBreakdownItems
			src = Utils.ZigStringLiteralFor(.toCobraSource)
			sw.write(', [src], ')
			.writeZigDefForBreakdown(sw)

	def writeZigDefForBreakdown(sw as CurlyWriter)
		.writeZigDef(sw)


class NameExpr
	is partial

	get asZig as String
		return _definition.ZigName


class AsExpr
	is partial

	def writeZigStmt(sw as CurlyWriter) is override
		# this happens for declarations like "i as int"
		sw.write('// [_name] as [_type.name]\n')

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		sw.write(.asZig)


class AnonymousMethodExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		# note that C# delegates don't allow explicit return types
		# C# always infers the return type from the return statement
		sw.write('delegate')
		if .params.count
			sw.write('(')
			sep = ''
			for param in .params
				sw.write(sep)
				sw.write('[param.type.ZigRef] [param.ZigName]')
				sep = ', '
			sw.write(')')
		_method.writeZigImp(sw, false)  # writes { ... }

	def writeZigDefForBreakdown(sw as CurlyWriter) is override
		# .writeZigDef(sw)
		sw.write('new CobraCoreInternal.CobraDirectString("(anonymous method)")')


class LambdaExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		# note that C# delegates don't allow explicit return types
		# C# always infers the return type from the return statement
		sw.write('delegate')
		if .params.count
			sw.write('(')
			sep = ''
			for param in .params
				sw.write(sep)
				sw.write('[param.type.ZigRef] [param.ZigName]')
				sep = ', '
			sw.write(')')
		sw.write('{ return ')
		.expr.writeZigDef(sw, false)
		sw.write(';}')

	def writeZigDefForBreakdown(sw as CurlyWriter) is override
		# .writeZigDef(sw)
		sw.write('new CobraCoreInternal.CobraDirectString("(lambda)")')


class CallExpr is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		assert .superNode inherits DotExpr
		name = .name
		if _definition inherits BoxMember and (_definition to BoxMember).binaryName
			name = (_definition to BoxMember).binaryName to !
		else
			name = name.capitalized
		sw.write('[name]')
		if _genericArgTypes and _genericArgTypes.count
			sw.write('<')
			sep = ''
			for genericArgType in _genericArgTypes
				sw.write(sep + genericArgType.ZigRef)
				sep = ', '
			sw.write('>')
		sw.write('(')
		sep = ''
		for arg in _args
			sw.write(sep)
			if arg inherits AssignExpr  # named parameter
				# can't do arg.left.writeZigDef as binding invariants are incomplete
				# C# form is:  name:value
				sw.write((arg.left to IdentifierExpr).name) 
				sw.write(':')
				arg.right.writeZigDef(sw)
			else	
				arg.writeZigDefInContext(sw)
			sep = ', '
		sw.write(')')

	def writeZigBreakdownItems(sw as CurlyWriter) is override
		# leaving out the base call is intentional:
		# base.writeZigBreakdownItems(sw)
		sw.write(', +1')
		for expr in _args
			expr.writeZigBreakdownItems(sw)
		sw.write(', -1')


class EnumCallExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if parens
			sw.write('(')
		if _args.count == 0
			sw.write('default([_definition.ZigRef])')
		else
			sep = ''
			for member in _members
				sw.write(sep)
				sw.write(member.ZigRef)
				sep = '|'
		if parens
			sw.write(')')

	def writeZigBreakdownItems(sw as CurlyWriter)
		base.writeZigBreakdownItems(sw)
		sw.write(', +1')
		for member in _members
			sw.write(', ')
			sw.write(member.ZigRef)
		sw.write(', -1')


class ForExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		# C#:  CobraImp.For(stuff, delegate(x as int) { return x*x })
		# C#:  CobraImp.For(stuff, delegate(x as int) { if (x<0) return x*x; })
		inType = .inferredType
		outType = _getExpr.type
		sw.write('CobraCoreInternal.CobraImp.For<[inType.ZigRef],[outType.ZigRef]>(')
		if _stop
			# C#:  Numeric For Expr CobraImp.For(start, stop, step, delegate(x as int) { return x*x; })
			_start.writeZigDef(sw, false)
			sw.write(', ')
			_stop.writeZigDef(sw, false)
			sw.write(', ')
			_step.writeZigDef(sw, false)
		else
			_what.writeZigDef(sw, false)
		sw.write(', ')
		helperName = '_lh_for_[_var.name]_[_varNumber]'
		if _whereExpr is nil
			sw.write('delegate([inType.ZigRef] [helperName]) {\n')
			sw.indent
			sw.write('[_var.ZigName] = [helperName];\n')
			sw.write('return ')
			_getExpr.writeZigDef(sw, false)
			sw.write(';\n')
			sw.dedent
			sw.write('})')
		else
			outHelperName = helperName + '_out'
			sw.write('delegate([inType.ZigRef] [helperName], out [outType.ZigRef] [outHelperName]) {\n')
			sw.indent
			sw.write('[_var.ZigName] = [helperName];\n')
			sw.write('if (')
			_whereExpr.writeZigDef(sw, false)
			sw.write(') {\n')
			sw.indent
			sw.write('[outHelperName] = ')
			_getExpr.writeZigDef(sw, false)
			sw.write(';\n')
			sw.write('return true;\n')
			sw.dedent
			sw.write('} else {\n')
			sw.indent
			sw.write('[outHelperName] = [outType.ZigInit];\n')
			sw.write('return false;\n')
			sw.dedent
			sw.write('}\n')
			sw.dedent
			sw.write('})')

			
class TryCatchExpr is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		sw.write('CobraCoreInternal.CobraImp.RunTryCatchExpr<[_type.ZigRef]')
		if _excType
			sw.write(',')
			sw.write(_excType.ZigRef)
		sw.write('>(')
		# try-expr delegate
		sw.write('delegate() {\n')
		sw.indent
		sw.write('return (')
		.what.writeZigDef(sw, false)
		sw.write(');\n')
		sw.dedent
		sw.write('}')
		sw.write(', ')
		# get-expr delegate
		sw.write('delegate() {\n')
		sw.indent
		sw.write('return (')
		_getExpr.writeZigDef(sw, false)	
		sw.write(');\n')
		sw.dedent
		sw.write('})')
		

class IdentifierExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		# recall that this cannot be the right side of "foo.bar" since that is a MemberExpr
		Zig = .ZigQualification + .ZigName
		if _requiresTypeOf, Zig = 'typeof(' + Zig + ')'
		sw.write(Zig)

	get ZigQualification as String
		qual = ''
		if .definition inherits IVar
			# the only definition that has no parentNameSpace in practice is IVar
			pass
		else
			pn = .definition.parentNameSpace
			if pn, qual = pn.ZigQualifier
		return qual
		
	get ZigName as String
		assert .didBindImp
		assert .namedDefinition
		assert not .type inherits UnspecifiedType
		if .superNode inherits DotExpr
			assert this is not (.superNode to DotExpr).right  # should be a CallExpr or MemberExpr instead
		defi = .namedDefinition
		return defi.ZigName

	def _requiresTypeOf as bool
		# C# often requires typeof(Foo) instead of just plain Foo
		if not .isTypeReference, return false
		superNode = .superNode
		if superNode inherits DotExpr, return false
		if superNode inherits InheritsExpr, return false
		if superNode inherits PostCallExpr
			if superNode.expr is this
				return false
		return true

	def writeZigStmt(sw as CurlyWriter) is override
		assert .isCalling
		sw.write('[_name]();')

	get ZigAssignmentNames as List<of String>?
		require
			.didBindImp
			.namedDefinition
		body
			if _definition inherits IVar
				return _definition.ZigAssignmentNames
			else
				return nil

	def writeZigDefForBreakdown(sw as CurlyWriter) is override
		name = .ZigQualification + .ZigName
		# _requiresTypeOf may return false, but in the Zig def breakdown, typeof() is always required
		if .isTypeReference, name = 'typeof(' + name + ')'
		sw.write(name)


class IfExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		cond, tpart, fpart = .cond, .tpart, .fpart
		cast = tpart.type <> fpart.type
		# C# doesn't do the "greatest common denominator" thing like Cobra does, so some casting is in order
		sw.write('(')
		cond.writeZigDef(sw)
		sw.write('?')
		if cast, sw.write('([.type.ZigRef])(')
		tpart.writeZigDef(sw)
		if cast, sw.write(')')
		sw.write(':')
		if cast, sw.write('([.type.ZigRef])(')
		fpart.writeZigDef(sw)
		if cast, sw.write(')')
		sw.write(')')

	def writeZigBreakdownItems(sw as CurlyWriter)
		base.writeZigBreakdownItems(sw)

		sw.write(', +1') # indent

		cond, tpart, fpart = .cond, .tpart, .fpart
		cond.writeZigBreakdownItems(sw)
		# only one of the target expressions is actually evaluated

		# tpart:
		src = Utils.ZigStringLiteralFor(tpart.toCobraSource)
		sw.write(', [src], new CobraCoreInternal.CobraDirectString(')
		cond.writeZigDefForBreakdown(sw)
		sw.write(' ? CobraCoreInternal.CobraCore.ToTechString(')
		tpart.writeZigDefForBreakdown(sw)
		sw.write(') : "(not-evaluated)")')

		# fpart:
		src = Utils.ZigStringLiteralFor(fpart.toCobraSource)
		sw.write(', [src], new CobraCoreInternal.CobraDirectString(')
		cond.writeZigDefForBreakdown(sw)
		sw.write(' ? "(not-evaluated)" : CobraCoreInternal.CobraCore.ToTechString(')
		fpart.writeZigDefForBreakdown(sw)
		sw.write('))')

		sw.write(', -1') # dedent


class IndexExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if _target.type.isDynamic
			sw.write('CobraCoreInternal.CobraImp.GetIndexerValue(')
			_target.writeZigDef(sw, false)
			for expr in _args
				sw.write(', ')
				expr.writeZigDef(sw, false)
			sw.write(')')
			return
		if parens
			sw.write('(')
		if _target inherits IdentifierExpr
			if _target.isKindOf(.compiler.typeType)
				# here we're favoring "Foo[]" being an array type rather than a shared indexer
				sw.write(_target.name)
				handled = true
		if not handled
			_target.writeZigDef(sw)
		sw.write(r'[')
		sep = ''
		for expr in _args
			sw.write(sep)
			expr.writeZigDefInContext(sw)
			sep = ', '
		sw.write(']')
		if parens
			sw.write(')')

	def writeZigBreakdownItems(sw as CurlyWriter)
		base.writeZigBreakdownItems(sw)
		sw.write(', +1')
		_target.writeZigBreakdownItems(sw)
		for expr in _args
			expr.writeZigBreakdownItems(sw)
		sw.write(', -1')


class IsNilExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if parens
			sw.write('(')
		sw.write('(')
		_expr.writeZigDef(sw)
		sw.write(')')
		sw.write('==null')
		if parens
			sw.write(')')

	def writeZigBreakdownItems(sw as CurlyWriter)
		base.writeZigBreakdownItems(sw)
		_expr.writeZigBreakdownItems(sw)


class IsNotNilExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if parens, sw.write('(')
		sw.write('(')
		_expr.writeZigDef(sw)
		sw.write(')')
		sw.write('!=null')
		if parens, sw.write(')')

	def writeZigBreakdownItems(sw as CurlyWriter)
		base.writeZigBreakdownItems(sw)
		_expr.writeZigBreakdownItems(sw)


class MemberExpr is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		assert .superNode inherits DotExpr
		if _definition inherits BoxMember
			name = _definition.binaryName
		else if _definition inherits EnumMember
			name = _definition.ZigName
		if name is nil, name = _name.capitalized
		sw.write(name)
		if _definition and (_definition.isMethod or _name=='toString') and not _isReference  # TODO: axe the 'toString' check
			sw.write('()')

	def writeZigBreakdownItems(sw as CurlyWriter) is override
		pass


class OldExpr
	is partial

	var _ZigVarName as String?

	pro ZigVarName from var

	def writeZigAssignment(sw as CurlyWriter)
		require
			.didBindImp
			.ZigVarName
			.type
		body
			sw.write('[.type.ZigRef] [_ZigVarName] = ')
			_expr.writeZigDef(sw)
			sw.write(';\n')

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		assert _ZigVarName
		# this gets called when generating the `ensure` code
		sw.write(_ZigVarName)


class PostCallExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if _helperMethod
			sw.write(_helperMethod.name + '(')
			sep = ''
			for arg in _args
				sw.write(sep)
				if arg inherits AssignExpr
					arg = arg.right
				arg.writeZigDefInContext(sw, false)
				sep = ','
			sw.write(')')
		else
			if parens, sw.write('(')
			expr = _expr
			isMethodSig = false
			isDynamic = false
			if expr inherits TypeExpr
				if expr.containedType inherits ArrayType
					# arrays
					_writeNewCall(sw, nil, (expr.containedType to ArrayType).theWrappedType.ZigRef, false) 
				else
					_writeNewCall(sw, expr, '', true) 
			else if expr inherits IdentifierExpr
				if expr.isTypeReference
					_writeNewCall(sw, expr, '', true) 
				else if expr.receiverType inherits GenericParam # TODO: shouldn't expr.isTypeReference above have caught this?
					_writeNewCall(sw, nil, expr.receiverType.ZigRef, true) 
				else if expr.type.nonNil.isDescendantOf(.compiler.delegateType)
					isMethodSig = true
				else if expr.type.isSystemTypeClass or _type.isDynamic
					isDynamic = true
				else
					assert false, expr
			else if expr inherits IndexExpr
				if expr.type.nonNil.isDescendantOf(.compiler.delegateType)
					isMethodSig = true
				else if expr.type.isSystemTypeClass or _type.isDynamic
					isDynamic = true
				else
					assert false, expr
			else
				assert false, expr
			if isMethodSig
				expr.writeZigDef(sw, false)
				sw.write('(')
				.writeZigArgs(sw)
				sw.write(')')
			else if isDynamic
				defi = expr.definition
				assert not defi inherits Box, expr  # TODO: just curious
				what = if(defi inherits IType, 'typeof([defi.ZigName])', defi.ZigName to String)
				if defi inherits IVar
					if defi.type.isDynamic
						what = '(System.Type)' + what
				# TODO: could speed this up. see http://ayende.com/Blog/archive/2008/02/27/Creating-objects--Perf-implications.aspx
				sw.write('System.Activator.CreateInstance(')
				if what == r'[]'  # indexer - something like myList[idx]()
					expr.writeZigDef(sw)
				else
					sw.write(what)
				.writeZigArgs(sw, ', ')
				sw.write(')')
			if parens, sw.write(')')
				
	def _writeNewCall(sw as CurlyWriter, expr as Expr?, exprStr as String, isInvocation as bool)
		require expr or exprStr.length >0
		delimeters = if(isInvocation, '()', r'[]')  # invocation or index deref
		sw.write('new ')
		if expr, expr.writeZigDef(sw)
		else, sw.write(exprStr)
		sw.write(delimeters[0])
		.writeZigArgs(sw)
		sw.write(delimeters[1])
				
	def writeZigArgs(sw as CurlyWriter)
		.writeZigArgs(sw, '')

	def writeZigArgs(sw as CurlyWriter, sep as String)
		for arg in _args
			sw.write(sep)
			if arg inherits AssignExpr  # named parameter
				# cant do arg.left.writeZigDef as binding invariants are incomplete
				sw.write((arg.left to IdentifierExpr).name) 
				sw.write(':')				# C# form is name:value
				arg.right.writeZigDef(sw)
			else	
				arg.writeZigDefInContext(sw, false)
			sep = ','
		
	def writeZigBreakdownItems(sw as CurlyWriter)
		base.writeZigBreakdownItems(sw)
		sw.write(', +1')
		_expr.writeZigBreakdownItems(sw)
		for expr in _args
			expr.writeZigBreakdownItems(sw)
		sw.write(', -1')


class RefExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if parens
			sw.write('(')
		_expr.writeZigDef(sw, false)
		if parens
			sw.write(')')

	def writeZigBreakdownItems(sw as CurlyWriter)
		base.writeZigBreakdownItems(sw)
		# TODO


class ZigExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if parens, sw.write('(')
		if _ZigSource
			sw.write(_ZigSource)
		else
			sw.write(_expr.token.value)
		if parens, sw.write(')')


class SliceExpr
	is partial


	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		sw.write('CobraCoreInternal.CobraImp.GetSlice(')
		_target.writeZigDef(sw, false)
		sw.write(',')
		if _start is nil, sw.write('null')
		else, _start.writeZigDefInContext(sw, false)
		sw.write(',')
		if _stop is nil, sw.write('null')
		else, _stop.writeZigDefInContext(sw, false)
		sw.write(',')
		if _step is nil, sw.write('null')
		else, _step.writeZigDefInContext(sw, false)
		sw.write(')')

	def writeZigBreakdownItems(sw as CurlyWriter)
		base.writeZigBreakdownItems(sw)
		sw.write(', +1')
		_target.writeZigBreakdownItems(sw)
		if _start, _start.writeZigBreakdownItems(sw)
		if _stop, _stop.writeZigBreakdownItems(sw)
		if _step, _step.writeZigBreakdownItems(sw)
		sw.write(', -1')


class TruthExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		lparen = if(parens, '(', '')
		rparen = if(parens, ')', '')
		branch _treatment
			on Treatment.AsIs
				_expr.writeZigDef(sw, parens)
			on Treatment.InvokeRuntime
				sw.write('CobraCoreInternal.CobraImp.IsTrue(')
				_expr.writeZigDef(sw, false)
				sw.write(')')				
			on Treatment.CompareToZero
				sw.write('[lparen]0!=')
				_expr.writeZigDef(sw, true)
				sw.write(rparen)
			on Treatment.CompareToZeroChar
				sw.write("[lparen]'\\0'!=")
				_expr.writeZigDef(sw, true)
				sw.write(rparen)
			on Treatment.CompareToNull
				sw.write('[lparen]null!=')
				_expr.writeZigDef(sw, true)
				sw.write(rparen)

	def writeZigBreakdownItems(sw as CurlyWriter) is override
		# leaving out the base class is intentional:
		# base.writeZigBreakdownItems(sw, isFirstExpr)
		_expr.writeZigBreakdownItems(sw)


class TypeExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		ZigRef = _containedType.ZigRef
		if _requiresTypeOf()
			sw.write('typeof(')
			sw.write(ZigRef)
			sw.write(')')
		else
			sw.write(ZigRef)

	def _requiresTypeOf as bool
		# Cobra never requires that you wrap a type reference in typeof(Foo).
		# C# requires typeof() in a variety of circumstances and won't accept it in a variety of others.
		superNode = .superNode
		if superNode is nil
			return false
		else
			if superNode inherits DotExpr
				return false
			if superNode inherits PostCallExpr
				# could be Type(foo) or _bar(Type)
				# in C#, the second requires `typeof` and the first won't take it
				if superNode.expr is this
					return false
			if superNode inherits BinaryOpExpr
				if this is superNode.right
					if superNode inherits InheritsExpr or superNode inherits AbstractToExpr
						return false
			return true

	def writeZigDefForBreakdown(sw as CurlyWriter) is override
		requiresTypeOf = _requiresTypeOf
		if not requiresTypeOf, sw.write('typeof(')
		.writeZigDef(sw)
		if not requiresTypeOf, sw.write(')')


class AllOrAnyExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		sw.write('CobraCoreInternal.CobraImp.[.opName.capitalized](')
		.expr.writeZigDefInContext(sw)
		sw.write(')')

	def writeZigBreakdownItems(sw as CurlyWriter)
		base.writeZigBreakdownItems(sw)
		sw.write(', +1')
		.expr.writeZigBreakdownItems(sw)
		sw.write(', -1')


class UnaryOpExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if _op == 'PLUS'
			if parens
				sw.write('(')
			_expr.writeZigDef(sw, false)
			if parens
				sw.write(')')
			return
		if _expr.type.isDynamic
			specs = OperatorSpecs.unaryOpSpecsByCobraText
			assert specs.containsKey(.token.text)
			spec = specs[.token.text]
			opText = Utils.ZigStringLiteralFor(spec.opMethodName)
			sw.write('CobraCoreInternal.CobraImp.DynamicOp([opText], ')
			_expr.writeZigDef(sw, false)
			sw.write(')')
			return
		if parens
			sw.write('(')
		branch _op
			on 'MINUS'
				sw.write('-')
			on 'TILDE'
				sw.write('~')
			on 'NOT'
				sw.write('!')
			else
				throw FallThroughException(_op)
		_expr.writeZigDef(sw)
		if parens
			sw.write(')')

	def writeZigBreakdownItems(sw as CurlyWriter)
		base.writeZigBreakdownItems(sw)
		sw.write(', +1')
		_expr.writeZigBreakdownItems(sw)
		sw.write(', -1')


class Literal
	is partial

	get asZig as String
		return ''

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		sw.write(.asZig)


class AtomicLiteral
	is partial

	get willWriteZigBreakdownItems as bool is override
		return false


class BoolLit
	is partial

	get asZig as String is override
		return if(_value, 'true', 'false')


class CharLit
	is partial

	get asZig as String is override
		if _value[0] to int == 39, return "'\\''"  # single quote
		else, return "'" + _value.toString + "'"


class DecimalLit
	is partial

	get asZig as String is override
		return _value.toString(Utils.cultureInfoForNumbers) + 'm'


class FractionalLit
	is partial

	get asZig as String is override
		if _type == .compiler.floatType(32), suffix = 'f'
		else if _type == .compiler.floatType(64), suffix = ''
		else if _type == .compiler.decimalType, suffix = 'm'
		else, throw FallThroughException(_type)
		return _value.toString(Utils.cultureInfoForNumbers) + suffix


class FloatLit
	is partial

	get asZig as String is override
		# suppose you have the literal: 0.00001
		# using 'F' format for 'fixed point' gives '0.00' which loses the original value
		# using 'R' format for 'round trip' gives '1E-05'
		s = _value.toString('R', Utils.cultureInfoForNumbers)
		if s.indexOf('.') == -1 and 'E' not in s, s += '.0'
		if (.type to FloatType).size == 32, s += 'f'
		return s


class IntegerLit
	is partial

	get asZig as String is override
		s = ''
		if (info = .token.info) inherits int
			branch info
				on - 8, s = 'System.SByte'
				on + 8, s = 'System.Byte'
				on -16, s = 'System.Int16'
				on +16, s = 'System.UInt16'
				on -32, s = ''
				on +32, s = 'U'
				on -64, s = 'L'
				on +64, s = 'UL'
				else, throw FallThroughException(info)
		if s.length <= 2
			return _value.toString + s
		else
			return '([s])[_value.toString]'


class NilLiteral
	is partial

	get asZig as String is override
		return 'null'


class StringLit
	is partial

	get asZig as String is override
		return Utils.ZigStringLiteralFor(_string)


class StringSubstLit
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if _items.count>1
			sw.write('CobraCoreInternal.CobraImp.MakeString(')
		sep = ''
		for item in _items
			sw.write(sep)
			if item inherits StringLit
				item.writeZigDef(sw, true)  # CC: axe the "true" when the bug about overload groups crossing inheritance is fixed
			else if item inherits FormattedExpr
				sw.write('CobraCoreInternal.CobraImp._printStringMaker.MakeString(')
				item.expr.writeZigDef(sw)
				sw.write(',')
				sw.write(Utils.ZigStringLiteralFor(item.format))
				sw.write(')')
			else
				sw.write('CobraCoreInternal.CobraImp._printStringMaker.MakeString(')
				item.writeZigDef(sw, false)
				sw.write(')')
			sep = ','
		if _items.count>1
			sw.write(')')


class BaseLit
	is partial

	get asZig as String is override
		return 'base'


class ThisLit
	is partial

	get asZig as String is override
		return .compiler.curBox.ZigThis


class VarLit
	is partial

	get asZig as String is override
		return _name


class SequenceLit
	is partial

	def writeZigBreakdownItems(sw as CurlyWriter) is override  # CC: axe is override
		base.writeZigBreakdownItems(sw)
		sw.write(', +1')
		for expr in _exprs
			expr.writeZigBreakdownItems(sw)
		sw.write(', -1')


class ListLit
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		innerType = (_type to Box).genericParams[0]
		sw.write('CobraCoreInternal.CobraImp.MakeList<[innerType.ZigRef]>(typeof([_type.ZigRef])')
		if _exprs.count
			sw.write(', ')
			sep = ''
			for expr in _exprs
				sw.write(sep)
				expr.writeZigDef(sw, false)
				sep = ', '
		sw.write(')')


class ArrayLit
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		sw.write('new [_type.ZigRef] { ')
		if _exprs.count
			sep = ''
			for expr in _exprs
				sw.write(sep)
				expr.writeZigDef(sw, false)
				sep = ', '
		sw.write(' }')


class SetLit
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		innerType = (_type to Box).genericParams[0]
		sw.write('CobraCoreInternal.CobraImp.MakeSet<[innerType.ZigRef]>(typeof([_type.ZigRef])')
		if _exprs.count
			sw.write(', ')
			sep = ''
			for expr in _exprs
				sw.write(sep)
				expr.writeZigDef(sw, false)
				sep = ', '
		sw.write(')')


class DictLit
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		assert (_type to Box).genericParams.count==2
		keyType   = (_type to Box).genericParams[0]
		valueType = (_type to Box).genericParams[1]
		sw.write('CobraCoreInternal.CobraImp.MakeDict<[keyType.ZigRef],[valueType.ZigRef]>(typeof([_type.ZigRef])')
		if _entries.count
			sw.write(', ')
			sep = ''
			for entry in _entries
				sw.write(sep)
				entry[0].writeZigDef(sw)
				sw.write(',')
				entry[1].writeZigDef(sw)
				sep = ', '
		sw.write(')')

	def writeZigBreakdownItems(sw as CurlyWriter) is override  # CC: axe is override
		base.writeZigBreakdownItems(sw)
		sw.write(', +1')
		for entry in _entries
			# CC: keyExpr, valueExpr = entry
			keyExpr = entry[0]
			valueExpr = entry[1]
			keyExpr.writeZigBreakdownItems(sw)
			valueExpr.writeZigBreakdownItems(sw)
		sw.write(', -1')


class ToNilableOrNotExpr
	is partial

	def writeZigBreakdownItems(sw as CurlyWriter)
		base.writeZigBreakdownItems(sw)
		_expr.writeZigBreakdownItems(sw)


class ToNilableExpr
	is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if _expr.type.isReference
			# In C#/.NET, reference types are always "nilable"
			_expr.writeZigDef(sw)
		else
			# ex: ((int?)x)
			# ex: ((Color?)Color.Black)
			sw.write('(([_expr.type.ZigRef]?)')
			_expr.writeZigDef(sw, false)
			sw.write(')')


class ToNonNilableExpr
	is partial


	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		type = _expr.type
		if type inherits NilableType and not type.nonNil.isReference
			# ex: (x).Value
			# ex: (obj.foo).Value
			sw.write('(')
			_expr.writeZigDef(sw, false)
			sw.write(').Value')
		else if .compiler.options.boolValue('include-nil-checks')
			sw.write('(CobraCoreInternal.CobraCore._willCheckNil?CobraCoreInternal.CobraImp.CheckNonNil<[type.ZigRef]>([.ZigThis], [Utils.ZigStringLiteralFor(_expr.toCobraSource)], ')
			_expr.writeZigDef(sw, false)
			sw.write(', [.ZigSourceSiteArgs]):')
			_expr.writeZigDef(sw, false)
			sw.write(')')
		else
			_expr.writeZigDef(sw, parens)


##
## Binary Expressions
##

class BinaryOpExpr is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if parens, sw.write('(')
		_writeZigDef(sw)
		if parens, sw.write(')')

	def _writeZigDef(sw as CurlyWriter)
		pass

	def writeZigBreakdownItems(sw as CurlyWriter)
		base.writeZigBreakdownItems(sw)
		sw.write(', +1')
		_writeZigBreakdownItemsLeft(sw)
		_writeZigBreakdownItemsRight(sw)
		sw.write(', -1')

	def _writeZigBreakdownItemsLeft(sw as CurlyWriter)
		_left.writeZigBreakdownItems(sw)

	def _writeZigBreakdownItemsRight(sw as CurlyWriter)
		_right.writeZigBreakdownItems(sw)


class AbstractAssignExpr is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if _trackLocal
			sw.write('CobraCoreInternal.CobraImp.SetLocal("[_trackName]", ')
		else if parens
			sw.write('(')
		_writeZigDef(sw)
		if _trackLocal or parens
			sw.write(')')


class AssignExpr is partial

	def _writeZigDef(sw as CurlyWriter) is override
		.writeZigDefWithRight(sw, true)

	def writeZigDefWithRight(sw as CurlyWriter, right as bool)
		# TODO:
		# if trackLocal:
		#	out.write('CobraCoreInternal.CobraImp.SetLocal("%s", ' % .left.name)
		if _left inherits IndexExpr
			if _left.target.type.isDynamic
				# assigning to an indexer of a dynamically typed target requires special code gen
				sw.write('CobraCoreInternal.CobraImp.SetIndexerValue(')
				_left.target.writeZigDef(sw, false)
				sw.write(', ')
				_right.writeZigDef(sw, false)
				for expr in _left.args
					sw.write(', ')
					expr.writeZigDef(sw, false)
				sw.write(')')
				return
		handled = false
		if _left inherits IdentifierExpr
			ZigNames = _left.ZigAssignmentNames
			if ZigNames and ZigNames.count
				ZigNames.reverse
				for i in ZigNames.count
					sw.write(if(i==0, '', '='))
					assert ZigNames[i].length
					sw.write(ZigNames[i])
			else
				assert _left.ZigName <> ''
				sw.write(_left.ZigName)
			handled = true
		if not handled
			# `obj.foo = bar` where `obj` is dynamic, requires special handling
			if _left inherits DotExpr
				if _left.left.type.isDynamic
					assert _left.right inherits MemberExpr
					sw.write('CobraCoreInternal.CobraImp.SetPropertyValue(')
					_left.left.writeZigDef(sw, false)
					sw.write(', ')
					sw.write(Utils.ZigStringLiteralFor((_left.right to MemberExpr).name.capitalized))
					sw.write(', ')
					_right.writeZigDef(sw)
					sw.write(')')
					return
		if not handled
			# for something like "p.total = 0", cannot generate "(p.Total)=0" because then C# sees
			# the left hand side as an r-value instead an l-value/target. hence the false below.
			_left.writeZigDef(sw, false)
		sw.write('=')
		if right, _right.writeZigDefInContext(sw)
		# handle the case where a type got backed up because of assignment inside of an if-inherits
		if _backUpIfInheritsStack
			assert _left.definition inherits IVar
			_left.definition.ifInheritsStack = Stack<of IType>(_backUpIfInheritsStack)


class NumericPromoExpr is partial

	def _writeZigDefDynamic(sw as CurlyWriter)
		specs = OperatorSpecs.binaryOpSpecsByCobraText
		assert specs.containsKey(.token.text)
		spec = specs[.token.text]
		opText = Utils.ZigStringLiteralFor(spec.opMethodName)
		sw.write('CobraCoreInternal.CobraImp.DynamicOp([opText], ')
		_left.writeZigDef(sw)
		sw.write(', ')
		_right.writeZigDef(sw)
		sw.write(')')


class AugAssignMathExpr is partial

	def _writeZigDef(sw as CurlyWriter) is override
		if .isConcated
			_writeZigDefConcated(sw)
		else if _type.isDynamic
			_writeZigDefDynamic(sw)
		else
			_writeZigDefOperation(sw)

	def _writeZigDefConcated(sw as CurlyWriter)
		_left.writeZigDef(sw, false)
		sw.write(' = ')
		sw.write('(' + _left.type.ZigRef + ')')
		sw.write('CobraCoreInternal.CobraImp.Concated(')
		_left.writeZigDef(sw, false)
		sw.write(', ')
		_right.writeZigDef(sw, false)
		sw.write(')')

	def _writeZigDefDynamic(sw as CurlyWriter) is override
		_left.writeZigDef(sw)
		sw.write(' = ')
		specs = OperatorSpecs.binaryOpSpecsByCobraText
		assert specs.containsKey(.token.text)
		spec = specs[.token.text]
		opText = Utils.ZigStringLiteralFor(spec.opMethodName)
		sw.write('CobraCoreInternal.CobraImp.DynamicOp([opText], ')
		_left.writeZigDef(sw)  # TODO: add , false
		sw.write(', ')
		_right.writeZigDef(sw)  # TODO: add , false
		sw.write(')')

	def _writeZigDefOperation(sw as CurlyWriter)
		op = ''
		sep = ','  # for the method call case
		branch _op
			on 'PLUS_EQUALS'
				op = '+='
			on 'MINUS_EQUALS'
				op = '-='
			on 'STAR_EQUALS'
				op = '*='
			on 'STARSTAR_EQUALS'
				op = 'CobraCoreInternal.CobraImp.PowerTo('
			on 'SLASH_EQUALS'
				op = '/='
			on 'SLASHSLASH_EQUALS'
				if .left.type.nonNil.isDescendantOf(.compiler.anyIntType)
					op = '/='
				else
					op = 'CobraCoreInternal.CobraImp.IntDiv('
			on 'PERCENT_EQUALS'
				op = '%='
			else
				throw FallThroughException(_op)
		assert op.length
		if op.length==2   # C# operator. ex: *= +=
			_left.writeZigDef(sw)
			sw.write(op)
			_right.writeZigDef(sw)
		else              # method call that returns a value
			_left.writeZigDef(sw)
			sw.write('=')
			sw.write(op)  # ex: 'CobraCoreInternal.CobraImp.Foo('
			_left.writeZigDef(sw)
			sw.write(sep)
			_right.writeZigDef(sw)
			sw.write(')')


class AugAssignBitwiseExpr
	is partial

	def _writeZigDef(sw as CurlyWriter) is override
		if _left.type.isDynamic
			_left.writeZigDef(sw)
			sw.write(' = ')
			specs = OperatorSpecs.binaryOpSpecsByCobraText
			assert specs.containsKey(.token.text)
			spec = specs[.token.text]
			opText = Utils.ZigStringLiteralFor(spec.opMethodName)
			sw.write('CobraCoreInternal.CobraImp.DynamicOp([opText], ')
			_left.writeZigDef(sw)  # TODO: add , false
			sw.write(', ')
			_right.writeZigDef(sw)  # TODO: add , false
			sw.write(')')
			return
		op = ''
		branch _op
			on 'AMPERSAND_EQUALS'
				op = '&='
			on 'VERTICAL_BAR_EQUALS'
				op = '|='
			on 'CARET_EQUALS'
				op = '^='
			on 'DOUBLE_LT_EQUALS'
				op = '<<='
			on 'DOUBLE_GT_EQUALS'
				op = '>>='
			else
				throw FallThroughException(_op)
		assert op.length
		_left.writeZigDef(sw)
		sw.write(op)
		_right.writeZigDef(sw)


class BinaryBoolExpr
	is partial

	def _writeZigDef(sw as CurlyWriter) is override
		if _op=='IMPLIES'
			sw.write('!')
		_left.writeZigDef(sw)
		branch _op
			on 'AND'
				sw.write('&&')
			on 'OR' or 'IMPLIES'
				sw.write('||')
		_right.writeZigDef(sw)

	def _writeZigBreakdownItemsRight(sw as CurlyWriter) is override
		# have to respect the short circuit otherwise something like "s and s.length" will give
		# NullReference exception for "s.length"
		# solution is: given L and R,
		# write:   "R", (!(L) ? "short-circuted" : (R).ToString())
		# that's for 'AND'. for, 'OR', remove the !, for 'IMPLIES' it's like AND

		# so rather than:
		# _right.writeZigBreakdownItems(sw)
		# do this:
		src = Utils.ZigStringLiteralFor(_right.toCobraSource)
		ZigNot = if(_op=='OR', '', '!')
		sw.write(', [src], new CobraCoreInternal.CobraDirectString([ZigNot]')
		_left.writeZigDefForBreakdown(sw)
		sw.write(' ? "(short-circuited)" : CobraCoreInternal.CobraCore.ToTechString(')
		_right.writeZigDefForBreakdown(sw)
		sw.write('))')


class BinaryBitwiseExpr
	is partial

	def _writeZigDef(sw as CurlyWriter) is override
		if _type.isDynamic
			_writeZigDefDynamic(sw)
			return
		op = ''
		branch _op
			on 'AMPERSAND'
				op = '&'
			on 'VERTICAL_BAR'
				op = '|'
			on 'CARET'
				op = '^'
			on 'DOUBLE_LT'
				op = '<<'
			on 'DOUBLE_GT'
				op = '>>'
			else
				throw FallThroughException(_op)
		assert op.length
		_left.writeZigDef(sw)
		sw.write(op)
		_right.writeZigDef(sw)


class BinaryMathExpr is partial

	def _writeZigDef(sw as CurlyWriter) is override
		if .isConcated
			_writeZigDefConcated(sw)
		else if _type.isDynamic
			_writeZigDefDynamic(sw)
		else
			_writeZigDefOperation(sw)

	def _writeZigDefConcated(sw as CurlyWriter)
		sw.write('(' + _left.type.ZigRef + ')')
		sw.write('CobraCoreInternal.CobraImp.Concated(')
		_left.writeZigDef(sw, false)
		sw.write(', ')
		_right.writeZigDef(sw, false)
		sw.write(')')

	def _writeZigDefOperation(sw as CurlyWriter)
		intType = .compiler.anyIntType
		left = _left
		right = _right
		op = ''
		pre = ''
		sep = ','  # for the method call case
		branch _op
			on 'PLUS'
				op = '+'
			on 'MINUS'
				op = '-'
			on 'STAR'
				op = '*'
			on 'STARSTAR'
				op = 'CobraCoreInternal.CobraImp.PowerTo('
			on 'SLASH'
				op = '/'
				if _left.isKindOf(intType) and _right.isKindOf(intType)
					pre = '(' + .compiler.numberType.ZigRef + ')'
			on 'SLASHSLASH'
				if left.isKindOf(intType) and right.isKindOf(intType)
					op = '/'
				else if left.isKindOf(.compiler.decimalType) or right.isKindOf(.compiler.decimalType)
					op = 'System.Decimal.Floor('
					sep = '/'
				else if left.isKindOf(.compiler.anyFloatType) or right.isKindOf(.compiler.anyFloatType)
					op = 'System.Math.Floor('
					sep = '/'
				else
					throw FallThroughException([left.type, right.type])
			on 'PERCENT'
				op = '%'
			else
				throw FallThroughException(_op)
		assert op.length
		sw.write(pre)
		if op.length==1
			_left.writeZigDef(sw)
			sw.write(op)
			_right.writeZigDef(sw)
		else
			sw.write(op)  # ex: 'CobraCoreInternal.CobraImp.Foo('
			_left.writeZigDef(sw)
			sw.write(sep)
			_right.writeZigDef(sw)
			sw.write(')')


class CompareExpr
	is partial

	var _cobraToZig = {
		'EQ': '==',
		'NE': '!=',
		'GT': '>',
		'LT': '<',
		'GE': '>=',
		'LE': '<=',
		'IS': '==',
		'ISNOT': '!=',
	}
	
	def _writeZigDef(sw as CurlyWriter) is override
		left = _left
		right = _right
		op = _op
		# Compute the C# operation which will be an operator or method call
		if op=='EQ' or op=='NE'
			if not left.type.isReference and not right.type.isReference
				# struct/value types
				if not left.type inherits PrimitiveType and not right.type inherits PrimitiveType
					# user-defined structs
					op = '.Equals('
				else
					# primitives like ints and decimals (even mixed like someDecimal == someInt)
					op = _cobraToZig[_op]
			else
				done = false
				stringType = .compiler.stringType
				if left.isKindOf(stringType) and right.isKindOf(stringType)  # TODO: check for static comparison operations instead
					op = _cobraToZig[_op]
					done = true
				else if left.type inherits Box  # TODO: try skipping on requiring that the type is a Box
					leftBox = left.type to Box
					compareTo = leftBox.memberForName('compareTo')
					if compareTo and compareTo.isMethod and compareTo.resultType.isDescendantOf(.compiler.anyIntType) and right.type.isDescendantOf(leftBox)  # need last condition to prevent someString.CompareTo(someChar)
						op = '.CompareTo('
						done = true
					equals = leftBox.methodForExactSignature('equals', [leftBox to IType], .compiler.boolType)
					if equals
						op = '.Equals('
						done = true
				if not done
					assert op in ['EQ', 'NE']
					assert op == .token.which
					op = if(op=='EQ', 'CobraCoreInternal.CobraImp.Equals(', 'CobraCoreInternal.CobraImp.NotEquals(')
		else if op=='IS' or op=='ISNOT'
			if left.type inherits PrimitiveType and right.type inherits PrimitiveType
				op = _cobraToZig[_op]
			else if left.type.isReference and right.type.isReference
				# skip the CobraCoreInternal.CobraImp.Is call for faster performance
				op = if(op=='IS', 'System.Object.ReferenceEquals(', '!System.Object.ReferenceEquals(')
			else
				# non-trivial situation.. fall back to runtime support
				op = if(op=='IS', 'CobraCoreInternal.CobraImp.Is(', 'CobraCoreInternal.CobraImp.IsNot(')
		else
			if left.type.isDynamic or right.type.isDynamic
				sw.write('CobraCoreInternal.CobraImp.DynamicCompare(')
				left.writeZigDef(sw, false)
				sw.write(', ')
				right.writeZigDef(sw, false)
				sw.write(')[_cobraToZig[_op]]0')
				return
			else
				done = false
				if left.type inherits Box  # TODO: try skipping on requiring that the type is a Box
					leftBox = left.type to Box
					compareTo = leftBox.memberForName('compareTo')
					if compareTo and compareTo.isMethod and compareTo.resultType.isDescendantOf(.compiler.anyIntType) and left.type == right.type  # need last condition to prevent someString.CompareTo(someChar)
						op = '.CompareTo('
						done = true
				if not done
					op = _cobraToZig[_op]
		# Write the C# code
		if op.length <= 2
			left.writeZigDef(sw)
			sw.write(op)
			right.writeZigDef(sw)
		else if op == '.Equals('
			if _op == 'NE', sw.write('!(')
			left.writeZigDef(sw)
			sw.write(op)
			right.writeZigDef(sw, false)
			sw.write(')')
			if _op == 'NE', sw.write(')')
		else if op == '.CompareTo('
			left.writeZigDef(sw)
			sw.write(op)
			right.writeZigDef(sw, false)
			sw.write(') [_cobraToZig[_op]] 0')
		else if op.endsWith('(')
			sw.write(op)
			left.writeZigDef(sw)
			sw.write(',')
			right.writeZigDef(sw)
			sw.write(')')
		else
			throw FallThroughException(op)


class ChainedCompareExpr is partial
	
	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		if parens, sw.write('(')
		.writeZigDef(sw)
		if parens, sw.write(')')
	
	def writeZigDef(sw as CurlyWriter) is override
		sw.write('CobraCoreInternal.CobraCore.ChainedComparison(')
		_items[0].writeZigDef(sw)
		itemIndex = 1
		for operation in _operations
			sw.write(', "[operation]", ')
			_items[itemIndex].writeZigDef(sw)
			itemIndex += 1
		sw.write(')')


class DotExpr
	is partial

	def needsContextCast as bool
		r = base.needsContextCast
		if not r
			r = .left.type.isDynamic
			# Why isn't the base implementation sufficient?
			# Because for `d.getType` where `d` is dynamic, the type of `d.getType` is *not*.
			# It`s System.Type because `getType` is recognized as an Object method.
			# This would confuse the code generation into thinking that `d.getType` is a statically typed expression.
		return r

	def _writeZigDef(sw as CurlyWriter) is override
		if _left.receiverType.isDynamic
			# handle dynamic typing
			if _dotRightExpr.definition
				sw.write('(' + _dotRightExpr.type.ZigRef + ')')
			if _right inherits MemberExpr
				sw.write('CobraCoreInternal.CobraImp.GetPropertyValue(')
				_left.writeZigDef(sw, not _left inherits DotExpr)
				sw.write(', ')
				sw.write(Utils.ZigStringLiteralFor(_right.name.capitalized))
				sw.write(')')
			else if _right inherits CallExpr
				sw.write('CobraCoreInternal.CobraImp.InvokeMethod(')
				_left.writeZigDef(sw, not _left inherits DotExpr)
				sw.write(', ')
				sw.write(Utils.ZigStringLiteralFor(_right.name.capitalized))
				for arg in _right.args
					sw.write(', ')
					arg.writeZigDef(sw, false)
				sw.write(')')
			else
				throw FallThroughException(_right)
		else
			# Given Cobra "A.B.C()" where C is a class/type/struct, then the C# needs to be "new A.B.C()"
			# (But stuff like this makes me wonder if the ASTs should be doing some transformations, like collapsing qualified types.)
			if _dotRightExpr.memberDefinition inherits BoxMember
				backing = _dotRightExpr.definition.sharedMethodBacking to String?
				if backing
					# example:  Cobra: c.isUpper   C#: char.IsUpper(c)
					# also used for extension methods under .NET 2.0
					sw.write(backing+'(')
					if not (_dotRightExpr.memberDefinition to BoxMember).sharedMethodBackingIsAlias  # guard against Cobra "decimal.parse('5.0')" --> C# "Decimal.Parse(decimal, "5.0")"
						_left.writeZigDef(sw, false)
						sep = ', '
					else
						sep = ''
					if _right inherits CallExpr
						for arg in _right.args
							sw.write(sep)
							arg.writeZigDefInContext(sw)
							sep = ', '
					sw.write(')')
					return
			# handle static typing
			# don't write 'this' for shared members
			writeThis = true
			if _left inherits ThisLit
				writeThis = not _dotRightExpr.memberDefinition.isShared
			else if .curCodeMember inherits Initializer and _right inherits IDotRightExpr and (_right to IDotRightExpr).name == 'init' and _left inherits ThisOrBaseLit
				# Well, in practice this doesn't really happen because Constructer.innerWriteZigDef usurps the code gen for base calls
				Stmt.inInitCall = true
				didSetInInitCall = true
			if writeThis
				if _left.needsContextCast
					_left.writeZigDefInContext(sw)
				else
					_left.writeZigDef(sw, not _left inherits DotExpr)
				sw.write('.')
			_right.writeZigDef(sw, false)
			if didSetInInitCall
				Stmt.inInitCall = false

	def _writeZigBreakdownItemsLeft(sw as CurlyWriter) is override
		_left.writeZigBreakdownItems(sw)


class InExpr is partial

	def writeZigDef(sw as CurlyWriter, parens as bool) is override
		v = true
		branch _op
			on 'NOTIN', sw.write('!')
			on 'IN', pass
			else, throw FallThroughException(_op)
		if .needsNilCheck
			# Constraints:
			# (1) Don't evaluate the left expression twice
			# (2) Don't evaluate the right expression if the left is nil
			# In general, don't cause side effects from extra evaluation.
			if .left inherits IdentifierExpr and (.left to IdentifierExpr).definition inherits IVar
				# If the left is a var, there is no danger in double evaluation causing side effects.
				# Zig: (someVar==null ? false : <check>)
				sw.write('(')
				.left.writeZigDef(sw, false)
				sw.write('==null ? false : ')
				# may have to cast int? to int, for example
				if  .left.type inherits NilableType _
					and not .left.type.nonNil.isReference _
					and .containsExpr
					# well this last condition doesn't work so well due to generic args like List.Contains(T item)
					# and not (((.containsExpr to DotExpr).dotRight.memberDefinition to Method).params[0].type inherits NilableType)
					
					# then need cast
					assert .left.type inherits NilableType
					.right.writeZigDef(sw, false)
					sw.write('.Contains(([.left.type.nonNil.ZigRef])')
					.left.writeZigDef(sw)
					sw.write(')')
					if v, sw.write('/* A */')
				else
					.writeInCheckZig(sw, false, v)
					if v, sw.write('/* B */')
				sw.write(')')
			else
				# cobra: left in right
				# Zig: CobraCoreInternal.CobraImp.InWithNullCheck(<left>, delegate(__lh_value) { return <right>.Contains(__lh_value); })
				# use:   static public bool InWithNullCheck<T>(T a, Predicate<T> predicate)

				# cobra: left in right
				# Zig: CobraCoreInternal.CobraImp.In(left, delegate() { return right; })
				sw.write('CobraCoreInternal.CobraImp.InWithNullCheck(')
				.left.writeZigDef(sw, false)
				sw.write(', delegate([.left.type.ZigRef] __lh_value_[.serialNum]) { return ')
				if .containsExpr
					# Do not write the .containsExpr here because it's argument to .contains in the
					# full left expression. Instead, we want to pass the argument passed to the delegate.
					.right.writeZigDef(sw, false)
					sw.write('.Contains(([.left.type.nonNil.ZigRef]) __lh_value_[.serialNum]);')
					if v, sw.write('/* C */')
				else
					# No .containsExpr means we use CobraImp.In(a, b) for the delegate
					sw.write('CobraCoreInternal.CobraImp.In(__lh_value_[.serialNum], ')
					.right.writeZigDef(sw, false)
					sw.write(');')
					if v, sw.write('/* D */')
				sw.write(' })')
		else
			.writeInCheckZig(sw, parens, v)
			if v, sw.write('/* E */')

	def writeInCheckZig(sw as CurlyWriter, parens as bool, v as bool)
		if .containsExpr
			.containsExpr.writeZigDef(sw, parens)
			if v, sw.write('/* F */')
		else
			sw.write('CobraCoreInternal.CobraImp.In(')
			.left.writeZigDef(sw, false)
			sw.write(',')
			.right.writeZigDef(sw, false)
			sw.write(')')
			if v, sw.write('/* G */')


class InheritsExpr
	is partial
				
	def _writeZigDef(sw as CurlyWriter) is override
		_left.writeZigDef(sw)
		sw.write(' is ')
		_right.writeZigDef(sw, false)


class ToExpr is partial

	def needsContextCast as bool is override
		if .type.isDynamic, return base.needsContextCast
		else, return false  # the user is already casting, so go with their cast

	def _writeZigDef(sw as CurlyWriter) is override
		rightType = _potentialTypeExpr.potentialType to !   # it's not nil or _bindImp would have thrown an error
		if rightType is .compiler.passThroughType
			_left.writeZigDef(sw)
			return
		sw.write('(')
		_right.writeZigDef(sw, false)  # double parens would be pointless and also causes a C# error
		sw.write(')')
		if not rightType inherits NilableType and rightType.isReference and .compiler.options.boolValue('include-nil-checks')
			sw.write('CobraCoreInternal.CobraImp.CheckNonNil<[_left.type.ZigRef]>([.ZigThis], [Utils.ZigStringLiteralFor(_left.toCobraSource)], ')
			_left.writeZigDef(sw, false)
			sw.write(', [.ZigSourceSiteArgs])')
		else
			_left.writeZigDef(sw)


class ToQExpr
	is partial

	def _writeZigDef(sw as CurlyWriter) is override
		# x to? int     --> ((x is int || x is int?) ? (int?)x : (int?)null)
		# x to? int?    --> ((x is int || x is int?) ? (int?)x : (int?)null)
		# ^ but this would cause multiple evaluation of x, so...
		# x to? int?	--> (int?)CobraCoreInternal.CobraImp.ToOrNil(x)

		# x to? string  --> (x as String)
		# x to? string? --> (x as String)
		right = .right
		t = right.definition to IType
		t = t.nonNil
		typeZigRef = t.ZigRef
		if t.isReference
			sw.write('(')
			.left.writeZigDef(sw)
			sw.write(') as [typeZigRef]')
		else
			sw.write('[typeZigRef]?)CobraCoreInternal.CobraImp.ToOrNil<[typeZigRef]>(')
			.left.writeZigDef(sw)


class CoalesceExpr
	is partial

	def _writeZigDef(sw as CurlyWriter) is override
		_left.writeZigDef(sw)
		sw.write(' ?? ')
		_right.writeZigDef(sw)


class InverseCoalesceExpr
	is partial

	def _writeZigDef(sw as CurlyWriter) is override
		if _right inherits NilLiteral
			# `left ! nil` always returns nil -- it's like a no-op
			if _left inherits IdentifierExpr
				# no side effect possible
				sw.write('null')
			else
				# in case `left` has side effects, evaluate it
				sw.write('CobraCoreInternal.CobraImp.Return<[_type.ZigRef]>(null, ')
				_left.writeZigDef(sw, false)
				sw.write(')')
		else
			_left.writeZigDef(sw)
			sw.write('==null ? null : ')
			if not _right.type inherits NilableType and not _right.type inherits NilType
				sw.write('([_right.type.ZigRef]?)')
			_right.writeZigDef(sw)


class CoalesceAssignExpr
	is partial

	def _writeZigDef(sw as CurlyWriter) is override
		# L = L * R
		_left.writeZigDef(sw)
		sw.write(' = ')
		_left.writeZigDef(sw)
		sw.write(' ?? ')
		_right.writeZigDef(sw)


class InverseCoalesceAssignExpr
	is partial

	def _writeZigDef(sw as CurlyWriter) is override
		_left.writeZigDef(sw)
		sw.write(' = ')
		if _right inherits NilLiteral
			# `left != nil` is the same as `left = nil`
			sw.write('null')
		else
			_left.writeZigDef(sw)
			sw.write('==null ? null : ')
			if not _right.type inherits NilableType and not _right.type inherits NilType
				sw.write('([_right.type.ZigRef]?)')
			_right.writeZigDef(sw)


##
## Attributes
##

class AttributeDecl is partial

	def writeZigDef(sw as CurlyWriter) is override
		.writeZigDef(sw, '', true)

	def writeZigDef(sw as CurlyWriter, prefix as String)
		.writeZigDef(sw, prefix, true)

	def writeZigDef(sw as CurlyWriter, prefix as String, willNewLine as bool)
		sw.write(r'[')
		if .isReturnTarget and prefix == '', prefix = 'return:'
		sw.write(prefix)
		expr = _expr to PostCallExpr
		sw.write('[expr.type.ZigRef]')
		if expr.args.count
			sw.write('(')
			sep = ''
			for arg in expr.args
				sw.write(sep)
				if arg inherits AssignExpr
					sw.write(((arg.left to dynamic).name to String).capitalized) # CC: wouldn't need this if extension methods were registered with dynamic binder
					sw.write('=')
					arg = arg.right
				assert not arg inherits AssignExpr
				arg.writeZigDefInContext(sw)
				sep = ', '
			sw.write(')')
		sw.write(r']')
		if willNewLine, sw.writeLine('')


class AssemblyDecl
	is partial

	def writeZigDef(sw as CurlyWriter) is override
		base.writeZigDef(sw)
		for attrib in _attribs
			attrib.writeZigDef(sw, 'assembly: ')

	def writeZigTestInvocation(sw as CurlyWriter)
		pass


##
## Misc items
##

class ZigBackEndUtils

	shared

		var _backEndKeyWordList = 'abstract as base bool break byte case catch char checked class const continue decimal default delegate do double else enum event explicit extern false finally fixed float for foreach goto if implicit in int interface internal is lock long namespace new null object operator out override params private protected public readonly ref return sbyte sealed short sizeof stackalloc static string struct switch this throw true try typeof uint ulong unchecked unsafe ushort using virtual void volatile while'.split

		var _backEndKeyWordSet = Set<of String>()

		def isBackEndKeyWord(word as String) as bool
			"""
			Returns true if the given word is a keyword in C# 2.0.
			"""
			require
				word.length
			test
				assert .isBackEndKeyWord('object')
				assert .isBackEndKeyWord('if')
				assert not .isBackEndKeyWord('total')
			body
				if _backEndKeyWordSet.count == 0
					for word in _backEndKeyWordList
						_backEndKeyWordSet.add(word)
				return word in _backEndKeyWordSet

		def backEndNameForLocalVarName(name as String) as String
			if .isBackEndKeyWord(name)
				return '@' + name  # C# supports @ as a prefix to escape identifiers
			else
				return name
