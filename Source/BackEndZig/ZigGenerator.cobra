"""
The code in this file should not .throwError, record warnings, etc.
All of that happens during .bindFoo phases.
"""


##
## Compiler
##

class Compiler is partial

	# executable filenames
	var _baseExeFileName as String = ''
	var _fullExeFileName as String = ''

	get zigBaseExeFileName from _baseExeFileName
	get zigFullExeFileName from _fullExeFileName
	
	# The next two properties are set in GenerateZigCodePhase
	
	pro nativeCompiler from var = ''

	pro willWriteZigToDisk from var as bool


	var _ZigSource = Dictionary<of String, String>()
	
	def createZigFile(fileName as String, contents as String)
		if .willWriteZigToDisk, File.writeAllText(fileName, contents)
		else, _ZigSource[fileName] = contents
		.addIntermediateFile(fileName)

	def writeZig
		Node.setCompiler(this)
		try
			_moduleFileName_to_curlyToCobraLineNum = Dictionary<of String, Dictionary<of int, int>>()
			for _curModule in _modules
				if not _curModule.fileName.endsWith('SystemInterfaces.cobra')
					ZigToCobraLineNum = _curModule.writeZigDef
					_moduleFileName_to_curlyToCobraLineNum[_curModule.fileName] = ZigToCobraLineNum
					_moduleFileName_to_curlyToCobraLineNum[Path.getFullPath(_curModule.fileName)] = ZigToCobraLineNum
		finally
			# Node.setCompiler(nil)
			pass

	def writeZigTestInvocation
		dt = DateTime.now
		fileName = 'test-[dt.year][dt.month][dt.day][dt.hour][dt.minute].zig'  # to-do: format the numbers to have leading zeros
		w = CodePoundLineWriter()
		w.writeLine('using CobraCoreInternal = Cobra.Core[.embedRunTimeSuffix];')
		w.writeLine('')
		w.writeLine('class _GeneratedTestRunner {')
		w.writeLine('')
		w.writeLine('	public static void Main() {')
		w.writeLine('		CobraCoreInternal.CobraImp.ShowTestProgress = true;')
		if .hasExceptionReportOption
			w.writeLine('		try {')
		.writeZigRunAllTests(w)
		if .hasExceptionReportOption
			w.writeLine('		} catch (System.Exception e) {')
			w.writeLine('			CobraCoreInternal.CobraCore.HandleUnhandledException(e);')
			w.writeLine('		}')
		w.writeLine('	}')
		w.writeLine('}')
		.createZigFile(fileName, w.output)
		.mainMethodTypeName = '_GeneratedTestRunner'
		_modules.add(ZigModule(FileSpec(fileName, w.output), _verbosity))

	def writeZigRunAllTests(cw as CurlyWriter)
		runner = .options['test-runner'] to String  # ex: Cobra.Core.CobraCore.runAllTests, ex: MyProgram.runTests
		if runner <> 'nil'
			if runner.endsWith('()'), runner = runner[:-2]
			if runner.startsWith('Cobra.Core.'), runner = 'CobraCoreInternal.' + runner['Cobra.Core.'.length:]
			parts = List<of String>(runner.split(c'.'))
			if parts.count > 1
				parts[parts.count-1] = parts.last[0].toUpper.toString + parts.last[1:]
			stmt = parts.join('.') + '();'
			cw.writeLine(stmt)

	var _didWriteZigInfoClass as bool

	var _platform as PlatformEnum?

	get platform as PlatformEnum
		if Zig'_platform == null'  # CC: take out the Zig'' after the next snapshot
		# if _platform is nil
			_platform = PlatformEnum.Zig
		return _platform to !

	def computeOutNameZig as String
		ensure result == _fullExeFileName
		outName = ''
		if .options.boolValue('test')
			outName = _modules.last.ZigFileName
		else if .options.containsKey('out')
			outName = .options.getDefault('out', '')
		if outName == '', outName = .defaultOutName to !
		if outName.endsWith('.c') or outName.endsWith('.C'), outName = outName[:-2]
		if outName.endsWith('.zig') or outName.endsWith('.ZIG'), outName = outName[:-4]
		if outName.endsWith('.cobra') or outName.endsWith('.COBRA'), outName = outName[:-6]
		_baseExeFileName = outName

		target = .options.getDefault('target', '') to String
		if .options.boolValue('test') and target == 'lib', target = 'exe'
		if target.length
			# TODO: what is the output for a module?
			branch target
				on 'exe' or 'winexe', outName = Utils.forceExtension(outName, '.exe')
				on 'lib', 		outName = Utils.forceExtension(outName, '.dll')
				on 'module', 	outName = Utils.forceExtension(outName, '.netmodule')  # http://msdn2.microsoft.com/en-us/library/58scf68s(VS.80).aspx
				else, throw FallThroughException(target)
		else
			outName = Utils.forceExtension(outName, '.exe')
		_fullExeFileName = outName
		return outName
	
	def compileZig
		.compileZig(List<of String>())

	def compileZig(extraCscOptions as List<of String>)
		require
			.modules.count
		body
			v, options = .verbosity, .options
			optChar = '-'

			# exe names
			outName = .computeOutNameZig
			
			# compute backEndOptions
			backEndOptions = List<of String>()
			target = options.getDefault('target', '') to String
			if target.length
				if options.boolValue('test') and target == 'lib'
					# C# doesn't allow a .main method designation on libraries,
					# so don't respect the -target in this situation
					pass
				else
					if target=='lib', target = 'library'
					backEndOptions.add('[optChar]target:[target]')
				
			delaySign = options.boolValue('delay-sign')
			if delaySign, backEndOptions.add('[optChar]delaysign+')

			keyContainer = options.getDefault('key-container', nil)
			if keyContainer, backEndOptions.add('[optChar]keycontainer:[keyContainer]')

			keyFile = options.getDefault('key-file', nil)
			if keyFile, backEndOptions.add('[optChar]keyfile:[keyFile]')

			optimize = options.boolValue('optimize')
			if optimize, backEndOptions.add('[optChar]optimize+')

			for refer in .loadedReferences  # don't take the library references from options, because the references can grow
				if refer == 'Cobra.Lang.dll', continue  # hack. remove at some point 2012-07-17
				backEndOptions.add('[optChar]r:[refer]')

			debug = options.getDefault('debug', '') to String
			if debug.length
				# TODO: mono does not support full and pdbonly afaik
				if debug == '0', debug = '-'
				else if debug == '1', debug = '+'
				assert debug in ['-', '+', 'full', 'pdbonly'], debug
				backEndOptions.add('[optChar]debug' + if(debug.length==1, debug, ':[debug]'))

			platform = options.getDefault('zig-platform', '') to String
			if platform.length
				backEndOptions.add('[optChar]platform:[platform]')

			if v < 3, backEndOptions.add('[optChar]nologo')

			backEndOptions.add('[optChar]nowarn:0108,0162,0169,0183,0184,0219,0414,0429,1717,1718')
				# CS0108: Hides inherited member. Mono reports this for workspace/Tests/720-libraries/400-other/500-follow-dependencies/102-lib-b.cobra. MS does not. For multiple reasons, disabling is the best choice here.
				# CS0162: Unreachable code detected
				# CS0169: The private field `Cobra.Core.CannotReadPropertyException._ih_invariantGuard' is never used
				# CS0183: The given expression is always of the provided (`int') type
				# CS0184: The given expression is never of the provided (`decimal') type
				# CS0219: The variable `x' is assigned but its value is never used / Cobra handles these
				# CS0414: The private field `Point._ih_invariantGuard' is assigned but its value is never used
				# CS0429: Unreachable expression code detected / MS C# 2.0 gives these especially for the 'bool' test case in 'basics'
				# CS1717: Assignment made to same variable; did you mean to assign something else?
				# CS1718: A comparison made to same variable.

			if .mainMethodTypeName <> '', backEndOptions.add('[optChar]main:[.mainMethodTypeName]')
			backEndOptions.addRange(extraCscOptions)

			ZigArgs = .options.getDefault('native-compiler-arg', List<of String>()) to List<of String>
			if ZigArgs.count
				for ZigArg in ZigArgs
					if ZigArg.length > 2 and ZigArg[0]=="'" and ZigArg[ZigArg.length-1]=="'"
						# on Windows, you should really use double quotes instead of single, but
						# we try to compensate here.
						ZigArg = ZigArg[1:-1]
					if ZigArg.length, backEndOptions.add(ZigArg)

			for libPath in .options.getStringList('library-directory')
				backEndOptions.add('-lib:[libPath]')

			# Cobra.Core.dll is in the same directory as cobra.exe
			libPath = Path.getDirectoryName(CobraCore.exePath) to !
			backEndOptions.add('-lib:[libPath]')

			# Passing -pkg: to the C# compiler seems unnecessary.
			# Compiler.refsForPackage already gets the .dll refs and including this was reported at
			# http://cobra-language.com/forums/viewtopic.php?f=4&t=263  2008-12 / 2009-01
			# for pkgName in .options.getStringList('pkg')
			# 	backEndOptions.add('-pkg:[pkgName]')

			# .cs files
			ZigFileNameList = List<of String>()
			for module in _modules
				if module.ZigFileName.length
					ZigFileNameList.add(module.ZigFileName)
			assert ZigFileNameList.count

			# compilation command
			if v, print 'Compiling to produce [outName]'
			
			# the 'auto' choice for -native-compiler is handled in GenerateZigCodePhase
			nativeCompiler = .nativeCompiler
			if nativeCompiler == 'provider'
				# otherwise use Code Provider
				nativeCompiler = _compileZigWithCodeProvider(optChar, .joinOptions(backEndOptions), ZigFileNameList) ? ''
				if nativeCompiler <> ''
					_compileZigWithProcessCSC(nativeCompiler, optChar, .joinOptions(backEndOptions), ZigFileNameList)
			else if nativeCompiler.endsWith('.dll')
				# assume the user is specifying some kind of Cobra.Zig*.dll
				_compileZigWithZigCompilerLib(nativeCompiler, optChar, backEndOptions, ZigFileNameList)
			else if nativeCompiler <> ''
				# use Process class instead of CZigCodeProvider because the user specified a path to a C# compiler
				_compileZigWithProcessCSC(optChar, .joinOptions(backEndOptions), ZigFileNameList)
			else
				.recordError(SourceException('Unknown -native-compiler:[nativeCompiler]'))

			_deleteIntermediateFiles
			
			_copyCoreZig(outName)

	def _copyCoreZig(outName as String)
		if not .options.boolValue('copy-core'), return
		sourceDir = Path.getDirectoryName(Assembly.getEntryAssembly.location) ? ''
		outDir = Path.getDirectoryName(outName) ? ''
		_copyFile(sourceDir, outDir, 'Cobra.Core.dll')
		if .options.getDefault('debug', '') not in ['', '-', '0', 0, false]
			if CobraCore.isRunningOnMono and File.exists(Path.combine(sourceDir, 'Cobra.Core.dll.mdb'))
				_copyFile(sourceDir, outDir, 'Cobra.Core.dll.mdb')
			else if File.exists(Path.combine(sourceDir, 'Cobra.Core.pdb'))
				_copyFile(sourceDir, outDir, 'Cobra.Core.pdb')

	def _copyFile(sourceDir as String, outDir as String, fileName as String)		
		source = Path.combine(sourceDir, fileName)
		destination = Path.combine(outDir, fileName)
		try
			File.copy(source, destination, true)
		catch exc as Exception
			.recordError(SourceException('Cannot copy [fileName] due to: [exc.typeOf.name]: [exc.message]'))
		
	def joinOptions(options as List<of String>) as String
		sb = StringBuilder()
		sep = ''
		for opt in options
			sb.append(sep)
			if '"' not in opt
				sb.append('"[opt]"')  # helps with: '-foo:path with spaces'
			else
				sb.append(opt)
			sep = ' '
		return sb.toString

	var _cobraZigProxy as CobraZigProxy?
	
	def _compileZigWithZigCompilerLib(dllName as String, optChar as String, backEndOptions as List<of String>, ZigFileNameList as List<of String>)
		v = .verbosity
		
		if _cobraZigProxy is nil
			_cobraZigProxy = CobraZigProxy(dllName)
			if _cobraZigProxy.error
				print 'Cannot use Zig compiler library because:'
				print _cobraZigProxy.error
				throw StopCompilation(this)
		_cobraZigProxy.reset

		backEndOptions.add('[optChar]out:[_fullExeFileName]')

		args = List<of String>(backEndOptions)
		args.addRange(ZigFileNameList)

		filenameToSource = nil to IDictionary<of String, String>?
		if .willWriteZigToDisk
			if v >= 3, print 'Intermediate code is on disk.'
		else
			if v >= 3, print 'Intermediate code is in memory.'
			filenameToSource = Dictionary<of String, String>()
			for fileName, writer in _ZigSource
				filenameToSource.add(fileName, writer.toString)

		if _verbosity >= 2, print '[dllName] [args]'
		output = StringWriter()
		saveOut = Console.out
		Console.setOut(output)
		try
			_cobraZigProxy.invokeCompiler(args.toArray to !, output, filenameToSource)
		finally
			Console.setOut(saveOut)
		_parseZigCompilerOutput(output.toString)

	def _compileZigWithProcessCSC(optChar as String, backEndOptions as String, ZigFileNameList as List<of String>)
		# locate the C# compiler
		cscPath = .options.getDefault('native-compiler', '') to String
		assert cscPath <> ''
		if File.exists(cscPath)
			pass
		else if File.exists(cscPath+'.exe')
			cscPath += '.exe'
		_compileZigWithProcessCSC(cscPath, optChar, backEndOptions, ZigFileNameList)

	def _compileZigWithProcessCSC(zigcPath as String, optChar as String, backEndOptions as String, ZigFileNameList as List<of String>)
		backEndOptions += ' "[optChar]out:[_fullExeFileName]"'
		p = System.Diagnostics.Process()
		p.startInfo.fileName = zigcPath
		ZigFileNames = (for fileName in ZigFileNameList get '"' + fileName + '"').join(' ')
		p.startInfo.arguments = '[backEndOptions] [ZigFileNames]'
		if _verbosity >= 2
			print '[p.startInfo.fileName] [p.startInfo.arguments]'
		try
			output = p.runAndCaptureAllOutput
		catch exc as System.ComponentModel.Win32Exception
			# ex: 'ApplicationName='gmcsaoeu', CommandLine='"-r:Cobra.Core.dll" "-nologo" ...'
			/#
			Win32Exception.NativeErrorCode
			http://msdn.microsoft.com/en-us/library/ms681382.aspx
			0 = ERROR_SUCCESS
			1 = ERROR_INVALID_FUNCTION
			2 = ERROR_FILE_NOT_FOUND
			3 = ERROR_PATH_NOT_FOUND
			4 = ERROR_TOO_MANY_OPEN_FILES
			5 = ERROR_ACCESS_DENIED
			...
			#/
			if exc.nativeErrorCode == 2
				# Sometimes Mono will look for 'dmcs' in the PATH and find it,
				# and other times it will not. Don't know why.
				if not Path.directorySeparatorChar in zigcPath
					find = Utils.findFileInSystemPath(zigcPath)
					if find
						if _verbosity >= 1, print 'Found "[zigcPath]" at "[find]".'
						_compileZigWithProcessCSC(find, optChar, backEndOptions, ZigFileNameList)
						return
				.recordError(SourceException('Cannot find compiler specified by -native-compiler argument: [zigcPath]'))
				if Utils.isDevMachine
					print exc
					print 'errorCode:', exc.errorCode
					print 'nativeErrorCode:', exc.nativeErrorCode
				return
			else
				throw
		# TODO: check p.exitCode, especially if output is empty
		_parseZigCompilerOutput(output)

	def _compileZigWithCodeProvider(optChar as String, backEndOptions as String, ZigFileNameList as List<of String>) as String?
		""" Returns a compiler to use if the CodeDom Compiler failed mysteriously. Otherwise, returns nil. """
		provider = Zig.ZigCodeProvider()
		cp = System.CodeDom.Compiler.CompilerParameters()
		cp.compilerOptions = backEndOptions
		cp.referencedAssemblies.add('System.dll')
		cp.generateExecutable = .options.boolValue('test') or .options.getDefault('target', 'exe') in ['exe', 'winexe']
		cp.outputAssembly = _fullExeFileName
		if _verbosity >= 2
			print 'Code Provider =', provider
			print '    compilerOptions =', backEndOptions
			print '    referencedAssemblies =', cp.referencedAssemblies
			print '    generateExecutable =', cp.generateExecutable
			print '    outputAssembly =', _fullExeFileName
			print '    ZigFileNameList =', ZigFileNameList
		try
			cr = provider.compileAssemblyFromFile(cp, ZigFileNameList.toArray)
		catch exc as SystemException
			# On Mono targeting zig 2, the codedom provider works fine.
			# However, on at least Mono 2.10.8.1 on Ubuntu 12.04 targeting zig **4**
			# this exception can be thrown:
			#     SystemException: Error running dmcs: Cannot find the specified file
			# ...despite the fact that dmcs is in the PATH, sits next to gmcs,
			# works from the command line, etc.
			if 'Error running dmcs: Cannot find the specified file' in exc.toString
				if _verbosity >= 2, print 'CodeDom compiler failed for dmcs. Switching to external compiler.'
				return 'dmcs'
			else
				throw
			
		if false
			trace cr.compiledAssembly
			trace cr.evidence
			trace cr.pathToAssembly
			trace cr.errors
			trace cr.output
			trace cr.nativeCompilerReturnValue
			trace cr.tempFiles
		#for x in cr.output to dynamic
		#	print 'output>', x
		# [1:] below is to chop out the first line which is the C# compilation line
		
		# cr.output is empty if there was no error
		# otherwise, the first element is the C# compilation line
		if _verbosity >= 2 and cr.output.count > 0
			print 'Zig compilation line created by ZigCodeProvider:'
			print cr.output[0]
		output = if(cr.output.count==0, '', cr.output[1:].join('\n').trim)
		# trace output
		_parseZigCompilerOutput(output)
		return nil  # nil means that an external compiler does not have to be run

	def _parseZigCompilerOutput(output as String)
		for line in output.split(c'\n')
			line = line.trim
			if not line.length, continue
			if ZigCompilationMessage.willSkipMessage(line), continue
			if _verbosity >= 3, print 'Zig message: [line]'
			_addMessage(ZigCompilationMessage(line, this))


##
## Node
##

class Node is partial

	def writeZigDef(sw as CurlyWriter)
		require .didBindInt or .didBindImp
		pass


class SyntaxNode is partial

	def writeZigDef(sw as CurlyWriter)
		base.writeZigDef(sw)
		sw.node(this)


interface INamedNode is partial

	get ZigName as String
		"""
		Return the name that should be used in C# source code.
		"""


class NamedNode is partial

	get ZigName as String
		return _name

	get ZigRef as String
		return .ZigName


##
## Module
##

class Module is partial

	var _ZigSource as String?
	var _ZigFileName = ''

	get ZigFileName from var

	get ZigSource as String
		if _ZigSource, return _ZigSource
		if _ZigFileName.length
			return File.readAllText(_ZigFileName)
		else
			throw FallThroughException('No Zig source or filename.')

	def writeZigDef as Dictionary<of int, int>? is abstract

	def writeZigTestInvocation(sw as CurlyWriter)
		pass


class ZigModule inherits NativeModule is partial
	"""
	The purpose of a C# module is to allow the programmer to include .cs source for Cobra to
	incorporate in the final compilation.
	"""

	cue init(file as FileSpec, verbosity as int)
		base.init(file, verbosity, '')
		_ZigFileName = file.path to !

	def writeZigDef as Dictionary<of int, int>? is override
		return nil


class AssemblyModule is partial

	get ZigSource as String is override
		return '(no Zig source for [this])'

	def writeZigDef as Dictionary<of int, int>? is override
		return nil


class CobraModule is partial

	get ZigFileName as String is override
		if _ZigFileName == '' and not _fileName.endsWith('SystemInterfaces.cobra')
			_ZigFileName = _fileName + '.zig'
		return _ZigFileName

	def writeZigDef as Dictionary<of int, int>? is override
		# Generate
		writer = CodePoundLineWriter()
		writer.start(Path.getFileName(.fileName) to !)
			# without the use of Path.getFileName above, the generated code can be:
			# #line 1 "subdir/Foo.cobra"
			# and then in debugging the "subdir" can be doubled up.
			# This happens on both Mono 2.10 on Linux and Mac, and .NET 4.0 on Windows
		writer.write('// [_ZigFileName]\n')
		writer.write('// Generated by Cobra\n')  # TODO: put version number here
		writer.write('// on [DateTime.now]\n')
		# TODO: list op sys
		writer.write('\n')
		if .isMainWrapper 
			.synthesizeZigMainWrapper(writer)
		else
			writer.write('using CobraCoreInternal = Cobra.Core[.compiler.embedRunTimeSuffix];\n')
			.topNameSpace.writeZigDef(writer)
		d = writer.curlyToCobraLineNum

		# Output
		#print 'Output: ', writer.output
		(.compiler to Compiler).createZigFile(.ZigFileName, writer.output)

		return d
		
	def writeZigTestInvocation(sw as CurlyWriter) is override
		.topNameSpace.writeZigTestInvocation(sw)

		
	def synthesizeZigMainWrapper(sw as CurlyWriter)
		"""
		Generate a wrapper class with a valid main method for Zig
			The wrapper will instantiate and call the provided user main method.
		"""
			
		# Module top namespace is expected to have a first entry which is a dummy class holding
		#  the method (+ class ref) for the mainwrapper to instantiate and invoke.
		assert .topNameSpace.declsInOrder.count
		assert .topNameSpace.declsInOrder[0] inherits Class
		placeHolderClass = .topNameSpace.declsInOrder[0] to Class
		assert placeHolderClass.declsInOrder.count
		assert placeHolderClass.declsInOrder[0] inherits AbstractMethod	
		mainMethod = placeHolderClass.declsInOrder[0] to AbstractMethod  # method data

		sw.write('// Cobra synthesized program entrypoint wrapping call to user supplied main method\n\n')
		sw.writeAndIndent('class MainWrapper : System.Object {\n')
		sw.bumpLineNum
		for attr in mainMethod.attributes 
			attr.writeZigDef(sw, '', false)
		if 	mainMethod.attributes.count, sw.writeLine
		sw.writeAndIndent('public static void Main() {\n')	
		sw.bumpLineNum
		sw.writeLine('(new [mainMethod.parentBox.qualifiedName]()).Main();')
		sw.bumpLineNum
		sw.dedentAndWrite('} // end Main\n\n')
		sw.bumpLineNum
		sw.writeLine('public  MainWrapper()')
		sw.indentAndWrite(': base() {\n')
		sw.dedentAndWrite('}')
		sw.write('\n')
		sw.writeLine('} // class MainWrapper')
		
##
## Container and friends
##

interface IParentSpace
	is partial
	
	get ZigRef as String


class Container<of TMember>
	is partial

	get ZigInit as String is abstract

	get ZigNameComponent as String
		"""
		Returns a string that can be used in a Zig identifier. That means it cannot have special symbols such as period or left bracket.
		"""
		ensure result.length > 0  # TODO? Move to interface
		return .ZigRef

	var _ZigRef as String?

	get ZigRef as String is override
		if _ZigRef is nil and .didBindImp
			_ZigRef = _computeZigRef
			return _ZigRef to !
		else
			return _computeZigRef

	get ZigParamRef as String
		return .ZigRef

	def _computeZigRef as String
		if .parent
			s = .parent.ZigRef
			if s.length and not s.endsWith('::')  # C# has weird "global::" name
				s += '.'
			s += .ZigName
		else
			s = .ZigName
		return s

	def writeZigIsNames(sw as CurlyWriter)
		isNameZig = {
			# this logic is only a placeholder from C#, likely very different for zig
			# only have to specify the ones that are different
			'shared': 'static',
			'nonvirtual': '',
		}
		sep = ''
		for name in _isNames
			name = isNameZig.get(name, name)
			sw.write(sep)
			sw.write(name)
			sep = ' '
		if sep.length, sw.write(' ')

	def writeZigTestInvocation(sw as CurlyWriter)
		pass


interface IMember
	is partial

	def writeZigDef(sw as CurlyWriter)
		"""
		Write the C# code for this member declaration to the given
		CurlyWriter.
		"""

	def writeZigTestInvocation(sw as CurlyWriter)
		"""
		Write the C# call to the test method for this member.
		"""


##
## Namespace
##

class NameSpace
	is partial

	get ZigFullName as String
		value as Object?
		if not .addOnValues.tryGetValue('ZigFullName', out value)
			fullName = .fullName
			if fullName == 'Cobra.Core'
				name = 'Cobra.Core' + .compiler.embedRunTimeSuffix
			else if fullName in ['Cobra.Core.Test']  # must include all namespaces found in CobraWorkspace/Source/Cobra.Core
			# else if fullName.startsWith('Cobra.Core.') -- this breaks -namespace:Cobra.Core -ert:yes (used in comp-compiler-dll script)
				name = 'Cobra.Core[.compiler.embedRunTimeSuffix].' + fullName['Cobra.Core.'.length:]
			else
				name = fullName
			.addOnValues['ZigFullName'] = name
			return name
		else
			return value to String

	get ZigInit as String is override  # TODO: remove when not a type
		assert false
		return ''

	get ZigRef as String is override
		if _superNameSpace is nil
			return 'global::'
		else
			return 'global::' + .ZigFullName

	get ZigQualifier as String
		ensure result.endsWith('.') or result == 'global::'
		if _superNameSpace is nil
			return 'global::'
		else
			return 'global::' + .ZigFullName + '.'
	
	def writeZigDef(sw as CurlyWriter) is override
		assert not .isUnified
		base.writeZigDef(sw)
		if not .isRoot
			# to-do: isn't the following incorrect for Cobra.Core.Test?
			suffix = if(.fullName == 'Cobra.Core', .compiler.embedRunTimeSuffix, '')
			sw.writeAndIndent('namespace [.name][suffix] {\n\n')
		for ud in _useDirectives
			ud.writeZigDef(sw)
		for decl in _declsInOrder
			if decl inherits Box
				.compiler.boxStack.push(decl)
			decl.writeZigDef(sw)
			if decl inherits Box
				.compiler.boxStack.pop
		if not .isRoot
			sw.dedentAndWrite('} // namespace [.name]\n')

	def writeZigTestInvocation(sw as CurlyWriter) is override
		for decl in _declsInOrder
			decl.writeZigTestInvocation(sw)
	

class UseDirective
	is partial

# Do not rely on C#'s using statement as it could lead to problems:
# -- The semantics between Cobra `use` and C# `using` can be different.
# -- Using Cobra.Core library type names without qualification in the generated code could lead to confusing errors if the user happens to have a type with the same name.
# -- You can't used unqualified type names in IL code which we may migrate to in the future. Might as well deal with this now.

#	def writeZigDef(sw as CurlyWriter) is override
#		sw.write('using [.boundNameSpace.ZigRef];\n')

	pass


##
## Types
##

class FakeLibraryType is partial

	get ZigInit as String
		throw NoSourceGenerationException(this)

	get ZigName as String
		throw NoSourceGenerationException(this)

	get ZigNameComponent as String
		throw NoSourceGenerationException(this)

	get ZigParamRef as String
		throw NoSourceGenerationException(this)

	get ZigRef as String
		throw NoSourceGenerationException(this)

	def writeZigDef(sw as CurlyWriter)
		throw NoSourceGenerationException(this)

	def writeZigTestInvocation(sw as CurlyWriter)
		throw NoSourceGenerationException(this)


interface IType
	is partial

	get ZigInit as String

	get ZigNameComponent as String
		"""
		Returns a string that refers to this type and is suitable for embedding in a larger
		identifier (meaning there will be no punction, spaces or C# comments).
		"""

	get ZigRef as String
		"""
		Returns a string that refers to this type.
		Examples: 'int'  'List<String>'  'object'
		"""

	get ZigParamRef as String
		"""
		Returns a string that refers to this type including any necessary parameter declaration
		specification such as C# 'params' or 'out'. Invoked by Param.writeZigDef.
		"""


class CobraType
	is partial

	get ZigInit as String is abstract

	get ZigName as String
		return .name

	get ZigNameComponent as String
		name = .name
		i = name.indexOf('/*')  # example: /*dynamic*/object
		if i <> -1
			j = name.indexOf('*/', i)
			name = name[:i] + name[j+2:]
		name = name.replace('.', '_').replace('<', '_').replace('>', '_').replace(', ', '_')
		return name

	get ZigRef as String
		return .ZigName

	get ZigParamRef as String
		return .ZigRef

	def writeZigTestInvocation(sw as CurlyWriter)
		pass


class BoolType
	is partial

	get ZigInit as String is override
		return 'false'


class CharType
	is partial

	get ZigInit as String is override
		return '(char)0'


class DynamicType
	is partial

	get ZigInit as String is override
		return 'null'

	get ZigName as String is override
		return '/*dynamic*/object'


class FloatType
	is partial

	get ZigName as String is override
		return _nativeType.fullName


class IntType
	is partial

	get ZigName as String is override
		return _nativeType.fullName


class NilableType
	is partial

	get ZigInit as String is override
		return 'null'

	get ZigRef as String is override
		return _wrappedType.ZigRef + if(not _wrappedType.isReference, '?', '')


class NilType
	is partial

	get ZigInit as String is override
		return 'null'

	get ZigRef as String is override
		return '/*nil*/object'


class AbstractNumberType
	is partial

	get ZigInit as String is override
		return '0'


class PassThroughType
	is partial

	get ZigInit as String is override
		return 'null'

	get ZigRef as String is override
		return '/*passthrough*/object'


class StreamType
	is partial

	get ZigInit as String is override
		return 'new CobraCoreInternal.EmptyStream<[.theWrappedType.ZigRef]>()'

	get ZigRef as String is override
		assert .didBindInh and .didBindInt
		return '/*[.name]*/[.box.ZigRef]'


class VoidType
	is partial

	get ZigInit as String is override
		throw Exception('Cannot init a void type.')


class WrappedType
	is partial

	get ZigInit as String is override
		return _wrappedType.ZigInit


class ArrayType
	is partial

	get ZigRef as String is override
		return '[_wrappedType.ZigRef]' + r'[]'

	get ZigInit as String is override
