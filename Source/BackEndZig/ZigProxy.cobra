class CobraZigProxy
	"""
	Stub retained for source compatibility.

	The CLR backend had CobraSharpProxy which could invoke the C# compiler
	in-process via a reflection-loaded DLL (Cobra.Sharp.*.dll). There is no
	equivalent in-process path for the Zig compiler; compilation always
	happens by spawning the external `zig` process. This class is therefore
	a no-op and is not used by the current compilation pipeline.
	"""

	get dllName as String
		return ''

	get error as String?
		return 'In-process Zig compilation is not supported.'
